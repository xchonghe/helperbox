---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout
  title="URL Encoder / Decoder — Encode and Decode URLs"
  description="Free online URL encoder and decoder. Safely encode or decode URL components, and easily parse complex URLs into readable parts."
  lang="en"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is URL encoding?",
        "acceptedAnswer": { "@type": "Answer", "text": "URL encoding converts characters into a format that can be safely transmitted over the internet, replacing unsafe characters with a percent sign followed by hexadecimal digits." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between encodeURI and encodeURIComponent?",
        "acceptedAnswer": { "@type": "Answer", "text": "encodeURI is used for encoding a complete URL, leaving structural characters like : and / intact. encodeURIComponent encodes a URL parameter value, encoding all structural characters." }
      }
    ]
  }
  </script>

  <Header lang="en" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">URL Encoder / Decoder</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">URL Encoder / Decoder</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Encode or decode URL components instantly. All processing happens locally.
      </p>
    </div>

    <!-- 双栏操作区 -->
    <div class="grid gap-4 lg:grid-cols-2">
      <!-- 左侧输入 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium">Input</span>
          <button id="clear-btn" class="text-xs text-gray-500 hover:text-red-500 transition">Clear</button>
        </div>
        <textarea id="input-area" class="h-[300px] w-full resize-none bg-transparent p-4 font-mono text-sm outline-none placeholder:text-gray-400" placeholder="Paste your URL or text here..."></textarea>
      </div>

      <!-- 右侧输出 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Result</span>
          <div class="flex gap-2">
            <button id="encode-btn" class="rounded-md bg-indigo-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-indigo-700">Encode</button>
            <button id="decode-btn" class="rounded-md bg-gray-200 px-3 py-1 text-xs font-medium transition hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700">Decode</button>
            <button id="copy-btn" class="rounded-md px-2 py-1 text-xs text-gray-500 transition hover:bg-gray-200 dark:hover:bg-gray-800">Copy</button>
          </div>
        </div>
        <textarea id="output-area" readonly class="h-[300px] w-full resize-none bg-gray-50/50 p-4 font-mono text-sm outline-none dark:bg-gray-900/50" placeholder="Result will appear here..."></textarea>
      </div>
    </div>

    <div class="mt-4 flex items-center gap-4">
      <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
        <input type="radio" name="mode" value="component" checked class="accent-indigo-600" />
        <span>encodeURIComponent (For Parameters)</span>
      </label>
      <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
        <input type="radio" name="mode" value="full" class="accent-indigo-600" />
        <span>encodeURI (For Full URLs)</span>
      </label>
    </div>

    <div id="error-msg" class="mt-4 hidden rounded-lg bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400"></div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>What is URL encoding?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">URL encoding replaces unsafe ASCII characters with a "%" followed by two hexadecimal digits, ensuring data is transmitted safely over the internet.</p>
      </details>
    </div>

  </main>

  <Footer lang="en" />

  <script>
    const inputArea = document.getElementById('input-area') as HTMLTextAreaElement;
    const outputArea = document.getElementById('output-area') as HTMLTextAreaElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
    const modeRadios = document.querySelectorAll('input[name="mode"]');

    function process(action: 'encode' | 'decode') {
      const raw = inputArea.value.trim();
      if (!raw) return;
      
      const isComponent = (document.querySelector('input[name="mode"]:checked') as HTMLInputElement).value === 'component';

      try {
        if (action === 'encode') {
          outputArea.value = isComponent ? encodeURIComponent(raw) : encodeURI(raw);
        } else {
          outputArea.value = isComponent ? decodeURIComponent(raw) : decodeURI(raw);
        }
        errorMsg.classList.add('hidden');
      } catch (e: any) {
        outputArea.value = '';
        errorMsg.textContent = `Error: Invalid URL encoding.`;
        errorMsg.classList.remove('hidden');
      }
    }

    document.getElementById('encode-btn')?.addEventListener('click', () => process('encode'));
    document.getElementById('decode-btn')?.addEventListener('click', () => process('decode'));
    
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      inputArea.value = '';
      outputArea.value = '';
      errorMsg.classList.add('hidden');
    });

    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      if(!outputArea.value) return;
      await navigator.clipboard.writeText(outputArea.value);
      const btn = document.getElementById('copy-btn') as HTMLButtonElement;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    });
  </script>
</BaseLayout>