---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="Markdown 编辑器 — 实时预览与导出"
  description="免费在线 Markdown 编辑器。左侧编写，右侧实时渲染。支持一键复制 HTML 或下载 Markdown 文件。100% 本地处理。"
  lang="zh"
>
  <Header lang="zh" />

  <main class="mx-auto max-w-7xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">Markdown 编辑器</span>
    </nav>

    <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Markdown 编辑器</h1>
        <p class="mt-2 text-gray-600 dark:text-gray-400">
          左侧编写 Markdown，右侧实时查看精美排版。
        </p>
      </div>
      
      <!-- 操作按钮 -->
      <div class="mt-4 flex flex-wrap gap-2 md:mt-0">
        <button id="copy-html-btn" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">复制 HTML</button>
        <button id="download-md-btn" class="rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-900 dark:bg-gray-700 dark:hover:bg-gray-600">下载 .md</button>
        <button id="download-html-btn" class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-indigo-700">下载 .html</button>
      </div>
    </div>

    <div class="grid gap-4 lg:grid-cols-2 h-[75vh]">
      
      <!-- 左侧输入区 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Markdown 源码</span>
          <button id="clear-btn" class="text-xs text-red-500 hover:underline">清空</button>
        </div>
        <textarea id="markdown-input" class="h-full w-full resize-none bg-transparent p-4 font-mono text-sm outline-none placeholder:text-gray-400 dark:text-gray-100" placeholder="# 你好，世界&#10;&#10;在这里输入您的 **Markdown** 文本..."></textarea>
      </div>

      <!-- 右侧预览区 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">实时预览</span>
        </div>
        <!-- 预览内容滚动区，自带极简排版样式 -->
        <div id="preview-area" class="h-full w-full overflow-y-auto p-6 text-gray-800 dark:text-gray-200 prose max-w-none">
        </div>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/zh/word-counter" title="字数统计" desc="实时统计字数、词频和阅读时间。" icon="📝" />
        <ToolCard href="/zh/text-diff" title="文本对比" desc="对比两段文本并高亮差异。" icon="⚖️" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>支持 GitHub 风格的 Markdown 吗？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">支持。底层使用了极受欢迎的 `marked` 解析库，完美支持表格、代码块高亮以及任务列表等扩展语法。</p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <style>
    /* 为预览区编写极简的 Markdown 排版样式 */
    .prose h1 { font-size: 2em; font-weight: bold; margin-bottom: 0.5em; border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
    .prose h2 { font-size: 1.5em; font-weight: bold; margin-top: 1.5em; margin-bottom: 0.5em; border-bottom: 1px solid #eaecef; padding-bottom: 0.3em; }
    .prose h3 { font-size: 1.25em; font-weight: bold; margin-top: 1em; margin-bottom: 0.5em; }
    .prose p { margin-bottom: 1em; line-height: 1.6; }
    .prose ul, .prose ol { margin-bottom: 1em; padding-left: 2em; }
    .prose ul { list-style-type: disc; }
    .prose ol { list-style-type: decimal; }
    .prose blockquote { border-left: 4px solid #dfe2e5; color: #6a737d; padding-left: 1em; margin-bottom: 1em; }
    .prose code { background-color: rgba(27,31,35,.05); padding: .2em .4em; border-radius: 3px; font-family: monospace; font-size: 85%; }
    .prose pre { background-color: #f6f8fa; padding: 1em; border-radius: 6px; overflow-x: auto; margin-bottom: 1em; }
    .prose pre code { background-color: transparent; padding: 0; }
    .prose table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
    .prose th, .prose td { border: 1px solid #dfe2e5; padding: 0.5em; text-align: left; }
    .prose th { background-color: #f6f8fa; font-weight: bold; }
    .prose img { max-width: 100%; border-radius: 4px; }
    
    /* 暗黑模式下的样式微调 */
    :global(.dark) .prose h1, :global(.dark) .prose h2 { border-bottom-color: #333; }
    :global(.dark) .prose blockquote { border-left-color: #444; color: #999; }
    :global(.dark) .prose code { background-color: rgba(255,255,255,.1); }
    :global(.dark) .prose pre { background-color: #0d1117; }
    :global(.dark) .prose th, :global(.dark) .prose td { border-color: #333; }
    :global(.dark) .prose th { background-color: #161b22; }
  </style>

  <script>
    import { marked } from 'marked';
    import DOMPurify from 'dompurify';

    const markdownInput = document.getElementById('markdown-input') as HTMLTextAreaElement;
    const previewArea = document.getElementById('preview-area') as HTMLDivElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const copyHtmlBtn = document.getElementById('copy-html-btn') as HTMLButtonElement;
    const downloadMdBtn = document.getElementById('download-md-btn') as HTMLButtonElement;
    const downloadHtmlBtn = document.getElementById('download-html-btn') as HTMLButtonElement;

    // 初始化默认文本
    markdownInput.value = `# 欢迎使用 HelperBox!\n\n这是一款强大的 **Markdown 编辑器**。\n\n### 功能特点\n- 实时预览\n- 一键导出 HTML\n- 纯本地处理保护隐私\n\n> 在左侧修改文本，看看右侧的变化吧！\n\n\`\`\`javascript\nconsole.log("Happy coding!");\n\`\`\``;

    function renderMarkdown() {
      const rawText = markdownInput.value;
      // 使用 marked 解析，用 DOMPurify 防止 XSS 攻击
      const rawHtml = marked.parse(rawText) as string;
      const cleanHtml = DOMPurify.sanitize(rawHtml);
      previewArea.innerHTML = cleanHtml;
    }

    // 监听输入实时渲染
    markdownInput.addEventListener('input', renderMarkdown);

    // 清空
    clearBtn.addEventListener('click', () => {
      markdownInput.value = '';
      renderMarkdown();
    });

    // 复制 HTML 源码
    copyHtmlBtn.addEventListener('click', () => {
      const rawHtml = marked.parse(markdownInput.value) as string;
      const cleanHtml = DOMPurify.sanitize(rawHtml);
      navigator.clipboard.writeText(cleanHtml);
      const originalText = copyHtmlBtn.textContent;
      copyHtmlBtn.textContent = '已复制!';
      setTimeout(() => copyHtmlBtn.textContent = originalText, 2000);
    });

    // 下载 .md 文件
    downloadMdBtn.addEventListener('click', () => {
      const blob = new Blob([markdownInput.value], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'document.md';
      a.click();
      URL.revokeObjectURL(url);
    });

    // 下载 .html 文件
    downloadHtmlBtn.addEventListener('click', () => {
      const rawHtml = marked.parse(markdownInput.value) as string;
      const cleanHtml = DOMPurify.sanitize(rawHtml);
      const fullHtml = `<!DOCTYPE html>\n<html>\n<head>\n<meta charset="utf-8">\n<title>Markdown Export</title>\n<style>body{font-family:sans-serif;line-height:1.6;max-width:800px;margin:0 auto;padding:2rem;}</style>\n</head>\n<body>\n${cleanHtml}\n</body>\n</html>`;
      
      const blob = new Blob([fullHtml], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'document.html';
      a.click();
      URL.revokeObjectURL(url);
    });

    // 页面初始渲染
    renderMarkdown();
  </script>
</BaseLayout>