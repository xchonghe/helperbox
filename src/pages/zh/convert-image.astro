---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="图片格式转换 — JPG, PNG, WebP 互转"
  description="免费在线图片格式转换工具。在浏览器本地瞬间将图片转换为 JPG、PNG 或 WebP 格式。支持批量处理、画质调节，无需上传。"
  lang="zh"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "我的图片会被上传到服务器吗？",
        "acceptedAnswer": { "@type": "Answer", "text": "不会。所有图片处理都在您的浏览器本地完成。您的文件永远不会离开您的设备。" }
      },
      {
        "@type": "Question",
        "name": "我可以一次转换多张图片吗？",
        "acceptedAnswer": { "@type": "Answer", "text": "可以，您可以同时拖拽最多 20 张图片进行批量转换，工具会同时处理它们。" }
      }
    ]
  }
  </script>

  <Header lang="zh" />

  <main class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">图片格式转换</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">图片格式转换</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        在您的浏览器本地将图片转换为 JPG、PNG 或 WebP 格式。
      </p>
    </div>

    <!-- 控制栏 -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-2">
          <label for="format" class="text-sm font-medium text-gray-700 dark:text-gray-300">转换为：</label>
          <select id="format" class="rounded-md border border-gray-300 bg-transparent px-3 py-1.5 text-sm outline-none focus:border-indigo-500 dark:border-gray-700 dark:text-white">
            <option value="image/webp" class="dark:bg-gray-900">WebP</option>
            <option value="image/jpeg" class="dark:bg-gray-900">JPG</option>
            <option value="image/png" class="dark:bg-gray-900">PNG</option>
          </select>
        </div>
        <div class="flex items-center gap-2" id="quality-wrapper">
          <label for="quality" class="text-sm font-medium text-gray-700 dark:text-gray-300">质量：</label>
          <input type="range" id="quality" min="10" max="100" value="80" class="w-24 accent-indigo-600" />
          <span id="quality-value" class="text-xs text-gray-500 dark:text-gray-400">80%</span>
        </div>
      </div>
      <button id="convert-btn" class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50" disabled>
        全部转换
      </button>
    </div>

    <!-- 上传区（加了醒目的批量提示） -->
    <label for="file-input" id="drop-zone" style="height: 200px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
      <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
        <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      </div>
      <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或将图片拖拽到这里</p>
      <div class="mt-2 inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        支持批量处理 (最多 20 张)
      </div>
      <input type="file" id="file-input" multiple accept="image/*" style="display: none;" />
    </label>

    <div id="results-list" class="space-y-3"></div>

    <!-- 恢复的 FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>我的图片会被上传到服务器吗？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">不会。所有图片处理都使用 HTML5 Canvas 在您的浏览器本地完成。绝对保护隐私。</p>
      </details>

      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>我可以一次转换多张图片吗？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">可以，您可以同时拖拽最多 20 张图片进行批量转换，工具会同时处理它们。</p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    // JS 逻辑同上
    const dropZone = document.getElementById('drop-zone') as HTMLLabelElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const resultsList = document.getElementById('results-list') as HTMLDivElement;
    const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;
    const formatSelect = document.getElementById('format') as HTMLSelectElement;
    const qualityWrapper = document.getElementById('quality-wrapper') as HTMLDivElement;
    const qualityInput = document.getElementById('quality') as HTMLInputElement;
    const qualityValue = document.getElementById('quality-value') as HTMLSpanElement;

    let files: File[] = [];

    function formatSize(bytes: number) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    qualityInput.addEventListener('input', () => {
      qualityValue.textContent = qualityInput.value + '%';
    });

    formatSelect.addEventListener('change', () => {
      if (formatSelect.value === 'image/png') {
        qualityWrapper.style.opacity = '0.5';
        qualityInput.disabled = true;
      } else {
        qualityWrapper.style.opacity = '1';
        qualityInput.disabled = false;
      }
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
      if (e.dataTransfer?.files.length) handleFiles(e.dataTransfer.files);
    });
    
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) handleFiles(fileInput.files);
    });

    function handleFiles(newFiles: FileList) {
      const imgFiles = Array.from(newFiles).filter(f => f.type.startsWith('image/')).slice(0, 20);
      files = [...files, ...imgFiles];
      renderList();
    }

    function renderList() {
      resultsList.innerHTML = '';
      convertBtn.disabled = files.length === 0;

      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-3 shadow-sm dark:border-gray-800 dark:bg-gray-900';
        
        row.innerHTML = `
          <div style="width: 48px; height: 48px;" class="shrink-0 overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800">
            <img style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div class="flex-1 overflow-hidden">
            <p class="truncate text-sm font-medium text-gray-900 dark:text-white">${file.name}</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">原大小: ${formatSize(file.size)}</p>
          </div>
          <div class="result-action-${index} flex items-center">
            <button class="remove-btn text-xs text-red-500 hover:text-red-700 px-2">移除</button>
          </div>
        `;
        
        const reader = new FileReader();
        reader.onload = (e) => {
          const imgEl = row.querySelector('img');
          if (imgEl) imgEl.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);

        row.querySelector('.remove-btn')?.addEventListener('click', () => {
          files.splice(index, 1);
          renderList();
        });

        resultsList.appendChild(row);
      });
    }

    convertBtn.addEventListener('click', () => {
      if (!files.length) return;
      convertBtn.disabled = true;
      convertBtn.textContent = '转换中...';

      const targetType = formatSelect.value;
      const quality = parseInt(qualityInput.value) / 100;

      files.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0);

            canvas.toBlob((blob) => {
              if (!blob) return;
              const newSize = blob.size;
              const url = URL.createObjectURL(blob);
              const ext = targetType.split('/')[1].replace('jpeg', 'jpg');
              const newName = file.name.replace(/\.[^/.]+$/, "") + '.' + ext;

              const actionArea = document.querySelector(`.result-action-${index}`) as HTMLDivElement;
              actionArea.innerHTML = `
                <span class="text-xs font-medium text-green-600 dark:text-green-400 mr-2">转换后: ${formatSize(newSize)}</span>
                <a href="${url}" download="${newName}" class="rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 dark:hover:bg-indigo-900/50">下载</a>
              `;
            }, targetType, quality);
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });

      setTimeout(() => {
        convertBtn.disabled = false;
        convertBtn.textContent = '全部转换';
      }, 1000);
    });
  </script>
</BaseLayout>