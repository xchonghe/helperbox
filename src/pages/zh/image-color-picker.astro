---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="图片取色器 — 在线提取图片颜色与调色板"
  description="免费在线图片吸色与主色调提取工具。上传图片，精准获取任意位置的 HEX/RGB 颜色代码，并一键生成主色调配色方案。100% 本地处理。"
  lang="zh"
>
  <Header lang="zh" />

  <main class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">图片取色器</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">图片取色器</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        鼠标悬停或点击图片获取颜色，并自动提取图片主色调。
      </p>
    </div>

    <!-- 初始上传区 -->
    <div id="upload-section">
      <label for="file-input" id="drop-zone" style="height: 180px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
          <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
        </div>
        <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或将图片拖拽到这里</p>
        <input type="file" id="file-input" accept="image/*" style="display: none;" />
      </label>
    </div>

    <!-- 工作区 (默认隐藏) -->
    <div id="workspace" class="hidden grid gap-6 lg:grid-cols-3">
      
      <!-- 左侧图片预览区 -->
      <div class="relative flex min-h-[400px] min-w-0 items-center justify-center overflow-hidden rounded-xl border border-gray-200 bg-gray-100 p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900/50 lg:col-span-2">
        <!-- 限制图片大小，防止撑爆 -->
        <div id="image-container" class="relative flex h-[60vh] w-full items-center justify-center overflow-hidden cursor-crosshair">
          <img id="image-preview" src="" alt="取色图片" class="block max-h-full max-w-full object-contain pointer-events-none" />
          <!-- 跟随鼠标的预览悬浮窗 -->
          <div id="hover-tooltip" class="pointer-events-none absolute hidden items-center gap-2 rounded-lg bg-gray-900/90 px-3 py-2 text-white shadow-xl backdrop-blur-sm dark:bg-white/90 dark:text-gray-900">
            <div id="hover-color-box" class="h-6 w-6 rounded border border-white/20 dark:border-gray-300"></div>
            <span id="hover-color-hex" class="font-mono text-sm font-bold">#000000</span>
          </div>
        </div>
      </div>

      <!-- 右侧控制面板 -->
      <div class="flex w-full flex-col gap-5 rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        
        <!-- 当前选中颜色 -->
        <div>
          <h3 class="mb-3 text-sm font-bold text-gray-900 dark:text-white">当前选中颜色</h3>
          <div id="selected-color-area" class="flex flex-col gap-3 rounded-xl border border-gray-200 p-4 dark:border-gray-700">
            <div id="selected-color-box" class="h-16 w-full rounded-lg shadow-inner" style="background-color: #ffffff;"></div>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-gray-500">HEX</span>
              <span id="selected-hex" class="cursor-pointer font-mono text-sm font-bold text-gray-900 hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400">#FFFFFF</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm font-medium text-gray-500">RGB</span>
              <span id="selected-rgb" class="cursor-pointer font-mono text-sm font-bold text-gray-900 hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400">rgb(255, 255, 255)</span>
            </div>
          </div>
        </div>

        <!-- 自动提取主色调 -->
        <div>
          <h3 class="mb-3 text-sm font-bold text-gray-900 dark:text-white">图片主色调提取</h3>
          <div id="palette-area" class="grid grid-cols-3 gap-2">
            <!-- JS 会在这里生成色块 -->
          </div>
        </div>

        <hr class="border-gray-200 dark:border-gray-700" />
        
        <button id="reset-btn" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">
          重新上传图片
        </button>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/zh/color-converter" title="颜色转换器" desc="HEX, RGB, HSL 互转与调色板生成。" icon="🎨" />
        <ToolCard href="/zh/image-filter" title="图片滤镜" desc="实时调节照片参数与应用滤镜。" icon="🪄" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>如何复制颜色代码？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">直接点击右侧的 HEX 或 RGB 数值，或者点击提取出的调色板色块，即可自动复制到剪贴板。</p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    const uploadSection = document.getElementById('upload-section') as HTMLDivElement;
    const workspace = document.getElementById('workspace') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const imageContainer = document.getElementById('image-container') as HTMLDivElement;
    const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

    // 悬浮提示窗
    const hoverTooltip = document.getElementById('hover-tooltip') as HTMLDivElement;
    const hoverColorBox = document.getElementById('hover-color-box') as HTMLDivElement;
    const hoverColorHex = document.getElementById('hover-color-hex') as HTMLSpanElement;

    // 选中颜色展示
    const selectedColorBox = document.getElementById('selected-color-box') as HTMLDivElement;
    const selectedHex = document.getElementById('selected-hex') as HTMLSpanElement;
    const selectedRgb = document.getElementById('selected-rgb') as HTMLSpanElement;

    const paletteArea = document.getElementById('palette-area') as HTMLDivElement;

    let canvas = document.createElement('canvas');
    let ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    let currentImage: HTMLImageElement | null = null;

    // RGB 转 HEX
    function rgbToHex(r: number, g: number, b: number) {
      return '#' + [r, g, b].map(x => {
        const hex = x.toString(16);
        return hex.length === 1 ? '0' + hex : hex;
      }).join('').toUpperCase();
    }

    fileInput.addEventListener('change', (e) => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        imagePreview.src = ev.target?.result as string;
        
        imagePreview.onload = () => {
          currentImage = new Image();
          currentImage.src = imagePreview.src;
          currentImage.onload = () => {
            if (!currentImage) return;
            canvas.width = currentImage.width;
            canvas.height = currentImage.height;
            ctx.drawImage(currentImage, 0, 0);
            extractPalette();
          };
        };

        uploadSection.classList.add('hidden');
        workspace.classList.remove('hidden');
        workspace.classList.add('grid');
      };
      reader.readAsDataURL(file);
    });

    // 悬浮与点击取色
    imageContainer.addEventListener('mousemove', (e) => {
      if (!currentImage) return;
      
      const rect = imagePreview.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      // 确保鼠标在图片范围内
      if (x < 0 || y < 0 || x > rect.width || y > rect.height) {
        hoverTooltip.classList.add('hidden');
        hoverTooltip.classList.remove('flex');
        return;
      }

      // 计算实际图片像素坐标
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const pixelX = Math.floor(x * scaleX);
      const pixelY = Math.floor(y * scaleY);

      const pixelData = ctx.getImageData(pixelX, pixelY, 1, 1).data;
      const hex = rgbToHex(pixelData[0], pixelData[1], pixelData[2]);

      // 更新悬浮窗
      hoverColorBox.style.backgroundColor = hex;
      hoverColorHex.textContent = hex;
      
      // 调整悬浮窗位置
      hoverTooltip.style.left = `${e.clientX - rect.left + 15}px`;
      hoverTooltip.style.top = `${e.clientY - rect.top + 15}px`;
      hoverTooltip.classList.remove('hidden');
      hoverTooltip.classList.add('flex');
    });

    imageContainer.addEventListener('mouseleave', () => {
      hoverTooltip.classList.add('hidden');
      hoverTooltip.classList.remove('flex');
    });

    imageContainer.addEventListener('click', (e) => {
      if (!currentImage) return;
      const rect = imagePreview.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      if (x < 0 || y < 0 || x > rect.width || y > rect.height) return;

      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      const pixelX = Math.floor(x * scaleX);
      const pixelY = Math.floor(y * scaleY);

      const pixelData = ctx.getImageData(pixelX, pixelY, 1, 1).data;
      const hex = rgbToHex(pixelData[0], pixelData[1], pixelData[2]);
      const rgb = `rgb(${pixelData[0]}, ${pixelData[1]}, ${pixelData[2]})`;

      selectedColorBox.style.backgroundColor = hex;
      selectedHex.textContent = hex;
      selectedRgb.textContent = rgb;

      // 顺便复制到剪贴板
      navigator.clipboard.writeText(hex);
      const originalText = selectedHex.textContent;
      selectedHex.textContent = '已复制!';
      setTimeout(() => selectedHex.textContent = originalText, 1000);
    });

    // 自动提取主色调（缩放到 50x50 计算，防止卡顿）
    function extractPalette() {
      if (!currentImage) return;
      paletteArea.innerHTML = '';

      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = 50;
      tempCanvas.height = 50;
      const tempCtx = tempCanvas.getContext('2d', { willReadFrequently: true })!;
      tempCtx.drawImage(currentImage, 0, 0, 50, 50);
      
      const data = tempCtx.getImageData(0, 0, 50, 50).data;
      const colorCounts: Record<string, { count: number, r: number, g: number, b: number }> = {};

      for (let i = 0; i < data.length; i += 4) {
        const r = data[i];
        const g = data[i+1];
        const b = data[i+2];
        const a = data[i+3];

        if (a < 128) continue; // 忽略透明像素
        // 忽略极白和极黑的像素，以免调色板全是黑白
        if (r > 240 && g > 240 && b > 240) continue;
        if (r < 15 && g < 15 && b < 15) continue;

        // 量化颜色，将颜色按 30 的跨度分组
        const qr = Math.round(r / 30) * 30;
        const qg = Math.round(g / 30) * 30;
        const qb = Math.round(b / 30) * 30;
        const key = `${qr},${qg},${qb}`;

        if (!colorCounts[key]) {
          colorCounts[key] = { count: 0, r, g, b };
        }
        colorCounts[key].count++;
      }

      // 按出现次数排序
      const sortedColors = Object.values(colorCounts).sort((a, b) => b.count - a.count).slice(0, 6);

      sortedColors.forEach(color => {
        const hex = rgbToHex(color.r, color.g, color.b);
        const div = document.createElement('div');
        div.className = 'flex flex-col items-center gap-1 cursor-pointer group';
        div.innerHTML = `
          <div class="h-12 w-full rounded-lg shadow-sm transition group-hover:scale-105" style="background-color: ${hex};"></div>
          <span class="font-mono text-[10px] text-gray-500 group-hover:text-indigo-600 transition">${hex}</span>
        `;
        div.addEventListener('click', () => {
          navigator.clipboard.writeText(hex);
          const span = div.querySelector('span')!;
          span.textContent = '已复制';
          setTimeout(() => span.textContent = hex, 1000);
        });
        paletteArea.appendChild(div);
      });
    }

    resetBtn.addEventListener('click', () => {
      fileInput.value = '';
      imagePreview.src = '';
      currentImage = null;
      hoverTooltip.classList.add('hidden');
      workspace.classList.add('hidden');
      workspace.classList.remove('grid');
      uploadSection.classList.remove('hidden');
    });
  </script>
</BaseLayout>