---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="图片裁剪与旋转 — 在线裁剪、翻转照片"
  description="免费在线图片裁剪工具。轻松拖拽裁剪图片，支持 1:1、16:9 比例锁定、任意角度旋转与翻转。高清无损导出，100% 本地处理。"
  lang="zh"
>
  <Header lang="zh" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">图片裁剪与旋转</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">图片裁剪与旋转</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        精准裁剪您的照片。支持比例锁定、任意旋转翻转，一键下载高清图片。
      </p>
    </div>

    <!-- 初始上传区 -->
    <div id="upload-section">
      <label for="file-input" id="drop-zone" style="height: 200px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
          <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
        <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或将图片拖拽到这里</p>
        <input type="file" id="file-input" accept="image/*" style="display: none;" />
      </label>
    </div>

    <!-- 工作区 (默认隐藏) -->
    <div id="workspace" class="hidden grid gap-6 lg:grid-cols-3">
      
      <!-- 左侧操作区 (修复溢出) -->
      <div class="flex items-center justify-center min-h-[400px] min-w-0 overflow-hidden rounded-xl border border-gray-200 bg-gray-100 p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900/50 lg:col-span-2">
        <!-- 用一个定高的盒子把图片死死框住，不让它到处乱跑 -->
        <div class="relative flex h-[70vh] w-full items-center justify-center overflow-hidden">
          <img id="image-to-crop" src="" alt="待裁剪的图片" class="block max-h-full max-w-full object-contain" />
        </div>
      </div>

      <!-- 右侧控制面板 (占一列) -->
      <div class="flex w-full flex-col gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <h3 class="font-bold text-gray-900 dark:text-white">操作面板</h3>
        
        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">裁剪比例</label>
          <div class="grid grid-cols-2 gap-2">
            <button data-ratio="NaN" class="ratio-btn rounded-md border border-gray-300 bg-indigo-50 px-2 py-1.5 text-xs font-medium text-indigo-600 dark:border-gray-700 dark:bg-indigo-900/30 dark:text-indigo-400">自由拖拽</button>
            <button data-ratio="1" class="ratio-btn rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">1:1 (头像)</button>
            <button data-ratio="1.7777" class="ratio-btn rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">16:9 (视频)</button>
            <button data-ratio="1.3333" class="ratio-btn rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">4:3</button>
          </div>
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">旋转与翻转</label>
          <div class="grid grid-cols-3 gap-2">
            <button id="rotate-left" class="flex items-center justify-center rounded-md border border-gray-300 bg-white p-2 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700" title="向左旋转">
              <svg class="h-5 w-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
            </button>
            <button id="rotate-right" class="flex items-center justify-center rounded-md border border-gray-300 bg-white p-2 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700" title="向右旋转">
              <svg class="h-5 w-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10h-10a8 8 0 00-8 8v2M21 10l-6 6m6-6l-6-6"></path></svg>
            </button>
            <button id="flip-h" class="flex items-center justify-center rounded-md border border-gray-300 bg-white p-2 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700" title="水平翻转">
              <svg class="h-5 w-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
            </button>
          </div>
        </div>

        <hr class="border-gray-200 dark:border-gray-700" />
        
        <button id="download-btn" class="w-full rounded-lg bg-indigo-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-indigo-700 active:scale-95">
          下载裁剪后的图片
        </button>
        
        <button id="reset-btn" class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200">
          重新上传图片
        </button>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/zh/resize-image" title="调整尺寸" desc="在浏览器中修改图片的尺寸。" icon="📐" />
        <ToolCard href="/zh/compress-image" title="图片压缩" desc="在线压缩图片体积，不损失画质。" icon="🗜️" />
      </div>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    import Cropper from 'cropperjs';
    import 'cropperjs/dist/cropper.css';

    const uploadSection = document.getElementById('upload-section') as HTMLDivElement;
    const workspace = document.getElementById('workspace') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const imageElement = document.getElementById('image-to-crop') as HTMLImageElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

    let cropper: Cropper | null = null;

    fileInput.addEventListener('change', (e) => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        imageElement.src = ev.target?.result as string;
        
        uploadSection.classList.add('hidden');
        workspace.classList.remove('hidden');
        workspace.classList.add('grid');

        imageElement.onload = () => {
          if (cropper) cropper.destroy();
          cropper = new Cropper(imageElement, {
            viewMode: 1, 
            dragMode: 'move',
            autoCropArea: 0.8,
            restore: false,
            guides: true,
            center: true,
            highlight: false,
            cropBoxMovable: true,
            cropBoxResizable: true,
            toggleDragModeOnDblclick: false,
            // 关键：确保响应式计算准确
            responsive: true,
            checkOrientation: false
          });
        };
      };
      reader.readAsDataURL(file);
    });

    document.querySelectorAll('.ratio-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLButtonElement;
        const ratio = parseFloat(target.dataset.ratio || 'NaN');
        
        document.querySelectorAll('.ratio-btn').forEach(b => {
          b.className = 'ratio-btn rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200';
        });
        target.className = 'ratio-btn rounded-md border border-gray-300 bg-indigo-50 px-2 py-1.5 text-xs font-medium text-indigo-600 dark:border-gray-700 dark:bg-indigo-900/30 dark:text-indigo-400';

        if (cropper) {
          cropper.setAspectRatio(isNaN(ratio) ? NaN : ratio);
        }
      });
    });

    document.getElementById('rotate-left')?.addEventListener('click', () => cropper?.rotate(-90));
    document.getElementById('rotate-right')?.addEventListener('click', () => cropper?.rotate(90));
    document.getElementById('flip-h')?.addEventListener('click', () => {
      const scaleX = cropper?.getData().scaleX || 1;
      cropper?.scaleX(-scaleX);
    });

    downloadBtn.addEventListener('click', () => {
      if (!cropper) return;
      const canvas = cropper.getCroppedCanvas({
        maxWidth: 4096,
        maxHeight: 4096,
        fillColor: '#fff',
        imageSmoothingEnabled: true,
        imageSmoothingQuality: 'high',
      });

      canvas.toBlob((blob: Blob | null) => {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'cropped-image.png';
        a.click();
        URL.revokeObjectURL(url);
      }, 'image/png');
    });

    resetBtn.addEventListener('click', () => {
      if (cropper) cropper.destroy();
      cropper = null;
      fileInput.value = '';
      imageElement.src = '';
      workspace.classList.add('hidden');
      workspace.classList.remove('grid');
      uploadSection.classList.remove('hidden');
    });
  </script>
</BaseLayout>