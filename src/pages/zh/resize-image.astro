---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="调整图片尺寸 — 在线修改图片宽高"
  description="免费在线图片尺寸调整工具。在浏览器本地修改图片宽高，支持锁定宽高比防变形，支持批量处理。"
  lang="zh"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "调整尺寸会导致图片变形吗？",
        "acceptedAnswer": { "@type": "Answer", "text": "如果保持锁定宽高比按钮开启，修改宽度或高度时，另一个值会自动按比例缩放，从而防止图片变形。" }
      }
    ]
  }
  </script>

  <Header lang="zh" />

  <main class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">调整图片尺寸</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">调整图片尺寸</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        完全在浏览器本地修改图片宽高，支持批量处理。
      </p>
    </div>

    <!-- 上传区 -->
    <label for="file-input" id="drop-zone" style="height: 180px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
      <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
        <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
      </div>
      <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或将图片拖拽到这里</p>
      <input type="file" id="file-input" multiple accept="image/jpeg, image/png, image/webp" style="display: none;" />
    </label>

    <!-- 操作区 -->
    <div id="action-section" class="hidden flex-col gap-6">
      <!-- 尺寸设置 -->
      <div class="flex flex-wrap items-center gap-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700 dark:text-gray-300">宽度 (px):</label>
          <input type="number" id="input-width" min="1" class="w-24 rounded-md border border-gray-300 px-2 py-1.5 text-sm outline-none focus:border-indigo-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" />
        </div>
        
        <!-- 锁定比例按钮 -->
        <button id="lock-btn" class="rounded-md p-1.5 text-indigo-600 hover:bg-indigo-50 dark:text-indigo-400 dark:hover:bg-indigo-900/30" title="锁定宽高比">
          <svg id="lock-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
        </button>

        <div class="flex items-center gap-2">
          <label class="text-sm font-medium text-gray-700 dark:text-gray-300">高度 (px):</label>
          <input type="number" id="input-height" min="1" class="w-24 rounded-md border border-gray-300 px-2 py-1.5 text-sm outline-none focus:border-indigo-500 dark:border-gray-700 dark:bg-gray-800 dark:text-white" />
        </div>
        
        <button id="reset-btn" class="ml-auto text-sm text-red-500 hover:text-red-700">清空</button>
        <button id="resize-btn" class="rounded-lg bg-indigo-600 px-6 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 active:scale-95 disabled:opacity-50">全部调整</button>
      </div>

      <div id="results-list" class="space-y-3"></div>
    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/zh/compress-image" title="图片压缩" desc="在线压缩图片体积，不损失画质。" icon="🗜️" />
        <ToolCard href="/zh/convert-image" title="图片格式转换" desc="在 JPG, PNG, WebP 格式之间互转。" icon="🔄" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>调整尺寸会导致图片变形吗？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">如果保持锁定宽高比按钮开启，修改宽度或高度时，另一个值会自动按比例缩放，从而防止图片变形。</p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const actionSection = document.getElementById('action-section') as HTMLDivElement;
    const resultsList = document.getElementById('results-list') as HTMLDivElement;
    const inputWidth = document.getElementById('input-width') as HTMLInputElement;
    const inputHeight = document.getElementById('input-height') as HTMLInputElement;
    const lockBtn = document.getElementById('lock-btn') as HTMLButtonElement;
    const lockIcon = document.getElementById('lock-icon') as unknown as SVGElement;
    const resizeBtn = document.getElementById('resize-btn') as HTMLButtonElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;

    let files: File[] = [];
    let isLocked = true;
    let originalRatio = 1;

    lockBtn.addEventListener('click', () => {
      isLocked = !isLocked;
      lockIcon.style.opacity = isLocked ? '1' : '0.4';
    });

    inputWidth.addEventListener('input', () => {
      if (isLocked && originalRatio > 0) {
        inputHeight.value = Math.round(parseInt(inputWidth.value) / originalRatio).toString();
      }
    });

    inputHeight.addEventListener('input', () => {
      if (isLocked && originalRatio > 0) {
        inputWidth.value = Math.round(parseInt(inputHeight.value) * originalRatio).toString();
      }
    });

    resetBtn.addEventListener('click', () => {
      files = [];
      fileInput.value = '';
      actionSection.classList.add('hidden');
      actionSection.classList.remove('flex');
    });

    fileInput.addEventListener('change', () => {
      if (!fileInput.files?.length) return;
      const newFiles = Array.from(fileInput.files).filter(f => f.type.startsWith('image/')).slice(0, 20);
      files = [...files, ...newFiles];
      
      actionSection.classList.remove('hidden');
      actionSection.classList.add('flex');
      
      if (files.length > 0) {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            originalRatio = img.width / img.height;
            inputWidth.value = img.width.toString();
            inputHeight.value = img.height.toString();
            renderList();
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(files[0]);
      }
    });

    function renderList() {
      resultsList.innerHTML = '';
      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-3 shadow-sm dark:border-gray-800 dark:bg-gray-900';
        row.innerHTML = `
          <div style="width: 48px; height: 48px;" class="shrink-0 overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800">
            <img style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div class="flex-1 overflow-hidden">
            <p class="truncate text-sm font-medium text-gray-900 dark:text-white">${file.name}</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">原尺寸</p>
          </div>
          <div class="result-action-${index} flex items-center">
             <span class="text-xs text-gray-400">待处理</span>
          </div>
        `;
        const reader = new FileReader();
        reader.onload = (e) => {
          const imgEl = row.querySelector('img');
          if (imgEl) imgEl.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
        resultsList.appendChild(row);
      });
    }

    resizeBtn.addEventListener('click', () => {
      if (!files.length) return;
      resizeBtn.disabled = true;
      resizeBtn.textContent = '调整中...';

      const targetWidth = parseInt(inputWidth.value);
      const targetHeight = parseInt(inputHeight.value);
      if (!targetWidth || !targetHeight) {
        alert('请输入有效的宽高值。');
        resizeBtn.disabled = false;
        resizeBtn.textContent = '全部调整';
        return;
      }

      files.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = targetWidth;
            canvas.height = targetHeight;
            const ctx = canvas.getContext('2d');
            
            ctx!.imageSmoothingEnabled = true;
            ctx!.imageSmoothingQuality = 'high';
            ctx!.drawImage(img, 0, 0, targetWidth, targetHeight);

            canvas.toBlob((blob) => {
              if (!blob) return;
              const url = URL.createObjectURL(blob);
              const ext = file.type.split('/')[1] || 'jpg';
              const newName = file.name.replace(/\.[^/.]+$/, "") + `-${targetWidth}x${targetHeight}.${ext}`;

              const actionArea = document.querySelector(`.result-action-${index}`) as HTMLDivElement;
              actionArea.innerHTML = `
                <a href="${url}" download="${newName}" class="rounded-md bg-indigo-50 px-3 py-1.5 text-xs font-medium text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 dark:hover:bg-indigo-900/50">下载</a>
              `;
            }, file.type);
          };
          img.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);
      });

      setTimeout(() => {
        resizeBtn.disabled = false;
        resizeBtn.textContent = '全部调整';
      }, 800);
    });
  </script>
</BaseLayout>