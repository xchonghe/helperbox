---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
import { useTranslations } from '../../i18n';

const t = useTranslations('zh');

const categories = [
  {
    name: '图片工具',
    tools: [
      { href: '/zh/crop-image', title: '图片裁剪', desc: '精准裁剪、旋转与翻转图片。', icon: '✂️' },
      { href: '/zh/compress-image', title: '图片压缩', desc: '在浏览器内压缩图片体积，不损失画质。', icon: '🗜️' },
      { href: '/zh/convert-image', title: '格式转换', desc: '在 JPG, PNG, WebP 和 AVIF 之间互相转换。', icon: '🔄' },
      { href: '/zh/resize-image', title: '调整尺寸', desc: '在浏览器中修改图片的尺寸。', icon: '📐' },
      { href: '/zh/watermark', title: '图片加水印', desc: '在浏览器内为图片添加自定义文字水印。', icon: '💧' },
      { href: '/zh/remove-watermark', title: 'AI 去水印', desc: '智能擦除图片水印和杂物。', icon: '✨' },
      { href: '/zh/image-to-pdf', title: '图片转 PDF', desc: '将多张图片合并为专业 PDF。', icon: '📄' },
      { href: '/zh/image-stitcher', title: '长图拼接', desc: '将多张图片垂直合并为一张长图。', icon: '🪡' },
      { href: '/zh/image-filter', title: '图片滤镜', desc: '实时调节照片参数与应用滤镜。', icon: '🎨' },
      { href: '/zh/image-color-picker', title: '图片取色器', desc: '从图片提取 HEX/RGB 与主色调。', icon: '🎯' },
    ],
  },
  {
    name: 'PDF 工具',
    tools: [
      { href: '/zh/merge-pdf', title: '合并 PDF', desc: '把多个 PDF 合并成一个文件。', icon: '📎' },
      { href: '/zh/split-pdf', title: '拆分 PDF', desc: '把 PDF 拆分成单页文件。', icon: '✂️' },
    ],
  },
  {
    name: '开发者工具',
    tools: [
      { href: '/zh/json-formatter', title: 'JSON 格式化', desc: '瞬间格式化并校验 JSON 数据。', icon: '{ }' },
      { href: '/zh/base64', title: 'Base64 编解码', desc: '文本与 Base64 之间的互相转换。', icon: '🔐' },
      { href: '/zh/uuid-generator', title: 'UUID 生成器', desc: '随机生成 UUID v4 值。', icon: '🆔' },
      { href: '/zh/timestamp', title: '时间戳转换', desc: '把 Unix 时间戳转换为日期。', icon: '🕒' },
      { href: '/zh/url-encode', title: 'URL 编解码', desc: '对 URL 组件进行编码或解码。', icon: '🔗' },
      { href: '/zh/password-generator', title: '密码生成器', desc: '生成高强度且安全的随机密码。', icon: '🔑' },
      { href: '/zh/word-counter', title: '字数统计', desc: '实时统计字数、词频和阅读时间。', icon: '📝' },
      { href: '/zh/color-converter', title: '颜色转换', desc: 'HEX, RGB, HSL 互转与调色板生成。', icon: '🎨' },
      { href: '/zh/qr-generator', title: '二维码生成器', desc: '生成支持自定义颜色的高清二维码。', icon: '🔳' },
      { href: '/zh/text-diff', title: '文本对比', desc: '对比两段文本并高亮差异。', icon: '⚖️' },
      { href: '/zh/markdown-editor', title: 'Markdown 编辑器', desc: '实时预览 Markdown 并导出网页。', icon: '📄' },
    ],
  },
    {
    name: '计算器',
    tools: [
      { href: '/zh/percentage-calculator', title: '百分比计算器', desc: '瞬间解决各种百分比计算问题。', icon: '🧮' },
    ],
  },
];
---
<BaseLayout
  title="HelperBox — 在浏览器中运行的免费在线工具"
  description="免费的图片、PDF 和开发者工具。所有操作都在你的浏览器中进行 — 不上传，不注册。"
  lang="zh"
>
  <Header lang="zh" />

  <main>
    <!-- Hero 区 -->
    <section class="mx-auto max-w-6xl px-4 pt-20 pb-14 text-center">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
        {t.hero.title}
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-gray-600 dark:text-gray-400">
        {t.hero.subtitle}
      </p>

      <div class="mx-auto mt-8 max-w-xl">
        <input
          id="tool-search"
          type="search"
          placeholder={t.hero.searchPlaceholder}
          class="w-full rounded-xl border border-gray-300 bg-white px-5 py-3.5 text-base shadow-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-gray-700 dark:bg-gray-900"
        />
      </div>
    </section>

    <!-- 分类网格 -->
    <div class="mx-auto max-w-6xl px-4">
      {categories.map((cat) => (
        <section class="mb-14">
          <h2 class="mb-5 text-2xl font-bold tracking-tight">{cat.name}</h2>
          <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
            {cat.tools.map((tool) => <ToolCard {...tool} />)}
          </div>
        </section>
      ))}
    </div>
  </main>

  <Footer lang="zh" />

  <!-- 搜索过滤 -->
  <script>
    const input = document.getElementById('tool-search') as HTMLInputElement | null;
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>('[data-tool]').forEach((card) => {
        const name = (card.dataset.tool ?? '').toLowerCase();
        card.style.display = name.includes(q) ? '' : 'none';
      });
    });
  </script>
</BaseLayout>