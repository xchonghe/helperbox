---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="JSON 格式化与校验 — 在线美化 JSON"
  description="免费在线 JSON 格式化工具。在您的浏览器本地瞬间格式化、校验和压缩 JSON 数据。无需上传，保护隐私。"
  lang="zh"
>
  <!-- FAQ 的 SEO 结构化数据 -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "什么是 JSON 格式化？",
        "acceptedAnswer": { "@type": "Answer", "text": "JSON 格式化（也称美化）是指在 JSON 数据的键值对之间添加缩进和换行，使其更易于人类阅读和调试。" }
      },
      {
        "@type": "Question",
        "name": "为什么显示 JSON 错误？",
        "acceptedAnswer": { "@type": "Answer", "text": "如果您的 JSON 包含语法错误（例如缺少逗号、使用了单引号而非双引号等），工具会提示错误并指出原因。" }
      }
    ]
  }
  </script>

  <Header lang="zh" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">JSON 格式化</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">JSON 格式化</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        在下方粘贴您的 JSON 数据以进行格式化（美化）或压缩。如果格式错误，将会显示错误提示。
      </p>
    </div>

    <!-- 核心操作区 -->
    <div class="grid gap-4 lg:grid-cols-2">
      <!-- 左侧输入 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium">输入</span>
          <button id="clear-btn" class="text-xs text-gray-500 hover:text-red-500 transition">清空</button>
        </div>
        <textarea id="input-area" class="h-[400px] w-full resize-none bg-transparent p-4 font-mono text-sm outline-none placeholder:text-gray-400" placeholder="在此粘贴原始 JSON..."></textarea>
      </div>

      <!-- 右侧输出 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium text-gray-600 dark:text-gray-400">结果</span>
          <div class="flex gap-2">
            <button id="minify-btn" class="rounded-md bg-gray-200 px-3 py-1 text-xs font-medium transition hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700">压缩</button>
            <button id="format-btn" class="rounded-md bg-indigo-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-indigo-700">格式化</button>
            <button id="copy-btn" class="rounded-md px-2 py-1 text-xs text-gray-500 transition hover:bg-gray-200 dark:hover:bg-gray-800">复制</button>
          </div>
        </div>
        <textarea id="output-area" readonly class="h-[400px] w-full resize-none bg-gray-50/50 p-4 font-mono text-sm outline-none dark:bg-gray-900/50" placeholder="格式化后的 JSON 将显示在这里..."></textarea>
      </div>
    </div>

    <!-- 错误提示 -->
    <div id="error-msg" class="mt-4 hidden rounded-lg bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400"></div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">相关工具</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/zh/uuid-generator" title="UUID 生成器" desc="随机生成 UUID v4 值。" icon="🆔" />
        <ToolCard href="/zh/base64" title="Base64 编解码" desc="文本与 Base64 之间的互相转换。" icon="🔐" />
      </div>
    </div>

    <!-- FAQ 常见问题展示区 -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>什么是 JSON 格式化？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          JSON 格式化（也称美化）是指在 JSON 数据的键值对之间添加缩进和换行，使其更易于人类阅读和调试。它不会改变数据本身的内容。
        </p>
      </details>

      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>为什么显示 JSON 错误？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          如果您的 JSON 包含语法错误（例如缺少逗号、使用了单引号而非双引号、多了一个尾随逗号等），工具会提示错误并指出大致原因。
        </p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    const inputArea = document.getElementById('input-area') as HTMLTextAreaElement;
    const outputArea = document.getElementById('output-area') as HTMLTextAreaElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
    
    function processJSON(action: 'format' | 'minify') {
      const raw = inputArea.value.trim();
      if (!raw) {
        outputArea.value = '';
        errorMsg.classList.add('hidden');
        return;
      }
      try {
        const parsed = JSON.parse(raw);
        outputArea.value = action === 'format' 
          ? JSON.stringify(parsed, null, 2) 
          : JSON.stringify(parsed);
        errorMsg.classList.add('hidden');
      } catch (e: any) {
        outputArea.value = '';
        errorMsg.textContent = `错误：${e.message}`;
        errorMsg.classList.remove('hidden');
      }
    }

    document.getElementById('format-btn')?.addEventListener('click', () => processJSON('format'));
    document.getElementById('minify-btn')?.addEventListener('click', () => processJSON('minify'));
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      inputArea.value = '';
      outputArea.value = '';
      errorMsg.classList.add('hidden');
    });
    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      if(!outputArea.value) return;
      await navigator.clipboard.writeText(outputArea.value);
      const btn = document.getElementById('copy-btn') as HTMLButtonElement;
      btn.textContent = '已复制！';
      setTimeout(() => btn.textContent = '复制', 2000);
    });
  </script>
</BaseLayout>