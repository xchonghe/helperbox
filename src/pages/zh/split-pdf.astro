---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="PDF 拆分 — 在线提取 PDF 页面"
  description="免费在线 PDF 拆分工具。在浏览器本地安全地提取 PDF 中的特定页面或页面范围，无需上传，快速且保护隐私。"
  lang="zh"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "如何指定页码范围？",
        "acceptedAnswer": { "@type": "Answer", "text": "您可以输入单页或范围，并用逗号隔开。例如：1-3, 5, 8-10。" }
      },
      {
        "@type": "Question",
        "name": "我的 PDF 文件会被上传吗？",
        "acceptedAnswer": { "@type": "Answer", "text": "不会。所有 PDF 拆分操作都在您的浏览器本地完成。绝对保护您的文件隐私。" }
      }
    ]
  }
  </script>

  <Header lang="zh" />

  <main class="mx-auto max-w-3xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">PDF 拆分</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">PDF 拆分</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        在几秒钟内从您的 PDF 文档中提取特定页面。
      </p>
    </div>

    <!-- 初始上传区 -->
    <div id="upload-section">
      <label for="file-input" id="drop-zone" style="height: 180px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
        <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
          <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        </div>
        <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或拖拽 PDF 文件到这里</p>
        <input type="file" id="file-input" accept="application/pdf" style="display: none;" />
      </label>
    </div>

    <!-- 操作区 (选择文件后显示) -->
    <div id="action-section" class="hidden flex-col gap-6">
      <div class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-400">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"></path></svg>
        </div>
        <div class="flex-1 overflow-hidden">
          <p id="file-name" class="truncate text-sm font-medium text-gray-900 dark:text-white"></p>
          <p id="file-info" class="text-xs text-gray-500 dark:text-gray-400"></p>
        </div>
        <button id="reset-btn" class="text-sm text-red-500 hover:text-red-700">更换文件</button>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <label for="page-range" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">
          要提取的页面：
        </label>
        <input type="text" id="page-range" placeholder="例如: 1-3, 5, 8-10" class="mb-2 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 font-mono text-sm outline-none focus:border-indigo-500 dark:border-gray-700 dark:text-white" />
        <p class="text-xs text-gray-500 dark:text-gray-400">支持使用逗号分隔多个页码或范围。</p>
      </div>

      <button id="split-btn" class="w-full rounded-xl bg-indigo-600 px-6 py-3.5 text-base font-medium text-white transition hover:bg-indigo-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50">
        提取页面
      </button>
    </div>

    <div id="error-msg" class="mt-4 hidden rounded-lg bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400"></div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">常见问题</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>如何指定页码范围？</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">您可以输入单页或范围，并用逗号隔开。例如输入 <code>1-3, 5, 8-10</code> 将会提取第 1, 2, 3, 5, 8, 9, 10 页。</p>
      </details>
    </div>

  </main>

  <Footer lang="zh" />

  <script>
    import { PDFDocument } from 'pdf-lib';

    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const uploadSection = document.getElementById('upload-section') as HTMLDivElement;
    const actionSection = document.getElementById('action-section') as HTMLDivElement;
    const fileNameEl = document.getElementById('file-name') as HTMLParagraphElement;
    const fileInfoEl = document.getElementById('file-info') as HTMLParagraphElement;
    const pageRangeInput = document.getElementById('page-range') as HTMLInputElement;
    const splitBtn = document.getElementById('split-btn') as HTMLButtonElement;
    const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;

    let currentFile: File | null = null;
    let pdfDoc: PDFDocument | null = null;

    fileInput.addEventListener('change', async (e) => {
      const file = fileInput.files?.[0];
      if (!file || file.type !== 'application/pdf') return;
      await loadFile(file);
    });

    resetBtn.addEventListener('click', () => {
      currentFile = null;
      pdfDoc = null;
      fileInput.value = '';
      uploadSection.classList.remove('hidden');
      actionSection.classList.add('hidden');
      actionSection.classList.remove('flex');
      errorMsg.classList.add('hidden');
    });

    async function loadFile(file: File) {
      currentFile = file;
      errorMsg.classList.add('hidden');
      try {
        const arrayBuffer = await file.arrayBuffer();
        pdfDoc = await PDFDocument.load(arrayBuffer);
        
        const pageCount = pdfDoc.getPageCount();
        fileNameEl.textContent = file.name;
        fileInfoEl.textContent = `共 ${pageCount} 页`;
        
        uploadSection.classList.add('hidden');
        actionSection.classList.remove('hidden');
        actionSection.classList.add('flex');
      } catch (err: any) {
        errorMsg.textContent = '加载 PDF 出错：文件可能已损坏或有密码保护。';
        errorMsg.classList.remove('hidden');
      }
    }

    splitBtn.addEventListener('click', async () => {
      if (!pdfDoc || !currentFile) return;
      
      const rangeStr = pageRangeInput.value.trim();
      if (!rangeStr) {
        alert('请输入要提取的页码。');
        return;
      }

      splitBtn.disabled = true;
      splitBtn.textContent = '提取中...';
      errorMsg.classList.add('hidden');

      try {
        const totalPages = pdfDoc.getPageCount();
        const pagesToExtract: number[] = [];

        const parts = rangeStr.split(',');
        for (let part of parts) {
          part = part.trim();
          if (part.includes('-')) {
            const [startStr, endStr] = part.split('-');
            const start = parseInt(startStr, 10);
            const end = parseInt(endStr, 10);
            if (isNaN(start) || isNaN(end) || start < 1 || end > totalPages || start > end) {
              throw new Error(`无效的范围: ${part}`);
            }
            for (let i = start; i <= end; i++) {
              pagesToExtract.push(i - 1); 
            }
          } else {
            const page = parseInt(part, 10);
            if (isNaN(page) || page < 1 || page > totalPages) {
              throw new Error(`无效的页码: ${part}`);
            }
            pagesToExtract.push(page - 1);
          }
        }

        const uniquePages = Array.from(new Set(pagesToExtract)).sort((a, b) => a - b);
        if (uniquePages.length === 0) throw new Error('未指定有效的页面。');

        const newPdf = await PDFDocument.create();
        const copiedPages = await newPdf.copyPages(pdfDoc, uniquePages);
        copiedPages.forEach((page) => newPdf.addPage(page));

        const newPdfBytes = await newPdf.save();
        const blob = new Blob([newPdfBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `已提取-${currentFile.name}`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

      } catch (err: any) {
        errorMsg.textContent = `错误：${err.message}`;
        errorMsg.classList.remove('hidden');
      } finally {
        splitBtn.disabled = false;
        splitBtn.textContent = '提取页面';
      }
    });
  </script>
</BaseLayout>