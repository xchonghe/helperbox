---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout title="开发者工具 - HelperBox" description="免费在线开发者工具合集" lang="zh">
  <Header lang="zh" />
  <main class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">开发者工具</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">提高开发效率的极客工具箱。</p>
    </div>
    
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <ToolCard href="/zh/json-formatter" title="JSON 格式化" desc="瞬间格式化并校验 JSON 数据。" icon="{ }" />
      <ToolCard href="/zh/base64" title="Base64 编解码" desc="文本与 Base64 之间的互相转换。" icon="🔐" />
      <ToolCard href="/zh/uuid-generator" title="UUID 生成器" desc="随机生成 UUID v4 值。" icon="🆔" />
      <ToolCard href="/zh/timestamp" title="时间戳转换" desc="把 Unix 时间戳转换为日期。" icon="🕒" />
      <ToolCard href="/zh/url-encode" title="URL 编解码" desc="对 URL 组件进行编码或解码。" icon="🔗" />
      <ToolCard href="/zh/password-generator" title="密码生成器" desc="生成高强度且安全的随机密码。" icon="🔑" />
      <ToolCard href="/zh/word-counter" title="字数统计" desc="实时统计字数、词频和阅读时间。" icon="📝" />
      <ToolCard href="/zh/color-converter" title="颜色转换" desc="HEX, RGB, HSL 互转与调色板生成。" icon="🎨" />
      <ToolCard href="/zh/qr-generator" title="二维码生成器" desc="生成支持自定义颜色的高清二维码。" icon="🔳" />
      <ToolCard href="/zh/text-diff" title="文本对比" desc="对比两段文本并高亮差异。" icon="⚖️" />
      <ToolCard href="/zh/markdown-editor" title="Markdown 编辑器" desc="实时预览 Markdown 并导出网页。" icon="📄" />
    </div>
  </main>
  <Footer lang="zh" />
</BaseLayout>