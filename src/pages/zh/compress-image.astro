---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout
  title="图片压缩 — 在线无损压缩及指定大小压缩"
  description="免费在线图片压缩工具。支持指定压缩到特定 KB 大小，在浏览器本地批量压缩图片体积，无需上传，100% 保护隐私。"
  lang="zh"
>
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "指定大小压缩是如何工作的？",
        "acceptedAnswer": { "@type": "Answer", "text": "它使用二分查找算法，自动尝试不同的压缩质量，以找到能将图片大小控制在您指定 KB 范围内的最高质量设置。" }
      }
    ]
  }
  </script>

  <Header lang="zh" />

  <main class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/zh/" class="hover:text-indigo-600">首页</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">图片压缩</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">图片压缩</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        按质量压缩，或将图片指定压缩到精确大小，完全在浏览器本地运行。
      </p>
    </div>

    <!-- 控制栏与按钮合并 -->
    <div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="flex flex-wrap items-center justify-between gap-4">
        
        <!-- 左侧参数区 -->
        <div class="flex flex-wrap items-center gap-6">
          <!-- 模式选择 -->
          <div class="flex items-center gap-4 border-r border-gray-200 pr-6 dark:border-gray-700">
            <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
              <input type="radio" name="mode" value="quality" checked class="accent-indigo-600" />
              <span>按质量压缩</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2 text-sm font-medium">
              <input type="radio" name="mode" value="size" class="accent-indigo-600" />
              <span>指定大小压缩</span>
            </label>
          </div>

          <!-- 质量滑块 -->
          <div id="quality-wrapper" class="flex items-center gap-2">
            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">压缩质量：</label>
            <input type="range" id="quality" min="10" max="100" value="70" class="w-32 accent-indigo-600" />
            <span id="quality-value" class="text-xs font-mono font-medium text-indigo-600 dark:text-indigo-400 w-8">70%</span>
          </div>

          <!-- 目标大小输入框 (默认隐藏) -->
          <div id="size-wrapper" class="hidden items-center gap-2">
            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">希望大小：</label>
            <input type="number" id="target-size" min="1" value="100" class="w-20 rounded-md border border-gray-300 px-2 py-1 text-sm outline-none focus:border-indigo-500 dark:border-gray-700 dark:bg-gray-800" />
            <span class="text-sm font-medium text-gray-500">KB</span>
            <span class="text-xs text-gray-400 ml-2 hidden sm:inline">(实际结果会有一定偏差)</span>
          </div>
        </div>

        <!-- 右侧按钮区 (自动靠右) -->
        <button id="compress-btn" class="rounded-lg bg-indigo-600 px-6 py-2 text-sm font-medium text-white transition hover:bg-indigo-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-50" disabled>
          全部压缩
        </button>

      </div>
    </div>

    <!-- 上传区 -->
    <label for="file-input" id="drop-zone" style="height: 180px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
      <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
        <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
      </div>
      <p class="text-base font-medium text-gray-700 dark:text-gray-300">点击或将图片拖拽到这里压缩</p>
      <div class="mt-2 inline-flex items-center gap-1 rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        支持批量压缩
      </div>
      <input type="file" id="file-input" multiple accept="image/jpeg, image/png, image/webp" style="display: none;" />
    </label>

    <div id="results-list" class="space-y-3"></div>

  </main>

  <Footer lang="zh" />

  <script>
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const dropZone = document.getElementById('drop-zone') as HTMLLabelElement;
    const resultsList = document.getElementById('results-list') as HTMLDivElement;
    const compressBtn = document.getElementById('compress-btn') as HTMLButtonElement;
    const qualityInput = document.getElementById('quality') as HTMLInputElement;
    const qualityValue = document.getElementById('quality-value') as HTMLSpanElement;
    const targetSizeInput = document.getElementById('target-size') as HTMLInputElement;
    
    const modeRadios = document.querySelectorAll('input[name="mode"]');
    const qualityWrapper = document.getElementById('quality-wrapper') as HTMLDivElement;
    const sizeWrapper = document.getElementById('size-wrapper') as HTMLDivElement;

    let files: File[] = [];

    modeRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        if (val === 'quality') {
          qualityWrapper.classList.remove('hidden');
          qualityWrapper.classList.add('flex');
          sizeWrapper.classList.remove('flex');
          sizeWrapper.classList.add('hidden');
        } else {
          qualityWrapper.classList.add('hidden');
          qualityWrapper.classList.remove('flex');
          sizeWrapper.classList.remove('hidden');
          sizeWrapper.classList.add('flex');
        }
      });
    });

    function formatSize(bytes: number) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    qualityInput.addEventListener('input', () => {
      qualityValue.textContent = qualityInput.value + '%';
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
    });
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-indigo-500', 'bg-indigo-50', 'dark:bg-indigo-900/20');
      if (e.dataTransfer?.files.length) handleFiles(e.dataTransfer.files);
    });
    
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) handleFiles(fileInput.files);
    });

    function handleFiles(newFiles: FileList) {
      const imgFiles = Array.from(newFiles).filter(f => f.type.startsWith('image/')).slice(0, 20);
      files = [...files, ...imgFiles];
      renderList();
    }

    function renderList() {
      resultsList.innerHTML = '';
      compressBtn.disabled = files.length === 0;

      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-3 shadow-sm dark:border-gray-800 dark:bg-gray-900';
        
        row.innerHTML = `
          <div style="width: 48px; height: 48px;" class="shrink-0 overflow-hidden rounded-md bg-gray-100 dark:bg-gray-800">
            <img style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div class="flex-1 overflow-hidden">
            <p class="truncate text-sm font-medium text-gray-900 dark:text-white">${file.name}</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">原大小: ${formatSize(file.size)}</p>
          </div>
          <div class="result-action-${index} flex items-center">
            <button class="remove-btn text-xs text-red-500 hover:text-red-700 px-2">移除</button>
          </div>
        `;
        
        const reader = new FileReader();
        reader.onload = (e) => {
          const imgEl = row.querySelector('img');
          if (imgEl) imgEl.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);

        row.querySelector('.remove-btn')?.addEventListener('click', () => {
          files.splice(index, 1);
          renderList();
        });

        resultsList.appendChild(row);
      });
    }

    compressBtn.addEventListener('click', async () => {
      if (!files.length) return;
      compressBtn.disabled = true;
      compressBtn.textContent = '压缩中...';

      const mode = (document.querySelector('input[name="mode"]:checked') as HTMLInputElement).value;
      const quality = parseInt(qualityInput.value) / 100;
      const targetSizeKB = parseInt(targetSizeInput.value);
      const targetSizeBytes = targetSizeKB * 1024;

      for (let index = 0; index < files.length; index++) {
        const file = files[index];
        
        if (mode === 'size' && file.size <= targetSizeBytes) {
          processResult(index, file, file);
          continue;
        }

        await new Promise<void>((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => {
            const img = new Image();
            img.onload = async () => {
              const canvas = document.createElement('canvas');
              canvas.width = img.width;
              canvas.height = img.height;
              const ctx = canvas.getContext('2d');
              ctx?.drawImage(img, 0, 0);

              if (mode === 'quality') {
                canvas.toBlob((blob) => {
                  if (blob) processResult(index, file, blob);
                  resolve();
                }, 'image/jpeg', quality);
              } else {
                let low = 0.01;
                let high = 1.0;
                let bestBlob: Blob | null = null;

                for (let i = 0; i < 6; i++) {
                  const mid = (low + high) / 2;
                  const blob = await new Promise<Blob | null>(res => canvas.toBlob(res, 'image/jpeg', mid));
                  
                  if (blob) {
                    if (blob.size <= targetSizeBytes) {
                      bestBlob = blob;
                      low = mid; 
                    } else {
                      high = mid; 
                    }
                  }
                }
                
                if (!bestBlob) {
                  bestBlob = await new Promise<Blob | null>(res => canvas.toBlob(res, 'image/jpeg', 0.01));
                }
                
                if (bestBlob) processResult(index, file, bestBlob);
                resolve();
              }
            };
            img.src = e.target?.result as string;
          };
          reader.readAsDataURL(file);
        });
      }

      compressBtn.disabled = false;
      compressBtn.textContent = '全部压缩';
    });

    function processResult(index: number, originalFile: File, blob: Blob) {
      const isSmaller = blob.size < originalFile.size;
      const finalBlob = isSmaller ? blob : originalFile;
      const finalSize = isSmaller ? blob.size : originalFile.size;
      const savedPercent = Math.max(0, Math.round((1 - (finalSize / originalFile.size)) * 100));

      const url = URL.createObjectURL(finalBlob);
      const newName = originalFile.name.replace(/\.[^/.]+$/, "") + '-compressed.jpg';

      const actionArea = document.querySelector(`.result-action-${index}`) as HTMLDivElement;
      if (actionArea) {
        actionArea.innerHTML = `
          <div class="flex flex-col items-end gap-1">
            <div class="flex items-center gap-2">
              <span class="text-xs text-gray-400 line-through">${formatSize(originalFile.size)}</span>
              <span class="text-xs font-bold text-green-600 dark:text-green-400">${formatSize(finalSize)}</span>
            </div>
            <div class="flex items-center gap-2">
              ${savedPercent > 0 ? `<span class="text-[10px] bg-green-100 text-green-700 px-1.5 py-0.5 rounded dark:bg-green-900/30 dark:text-green-400">-${savedPercent}%</span>` : ''}
              <a href="${url}" download="${newName}" class="rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 dark:hover:bg-indigo-900/50">下载</a>
            </div>
          </div>
        `;
      }
    }
  </script>
</BaseLayout>