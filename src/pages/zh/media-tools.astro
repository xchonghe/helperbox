---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout title="媒体工具" description="免费在线音频和媒体工具。" lang="zh">
  <Header lang="zh" />
  <main class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">媒体工具</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">在浏览器中直接录制并可视化您的音频。</p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <ToolCard href="/zh/audio-recorder" title="语音录音机" desc="带实时声波可视化的录音工具。" icon="🎙️" />
    </div>
  </main>
  <Footer lang="zh" />
</BaseLayout>