---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ToolCard from '../../components/ToolCard.astro';
---
<BaseLayout title="PDF 工具 - HelperBox" description="免费在线 PDF 处理工具合集" lang="zh">
  <Header lang="zh" />
  <main class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">PDF 工具</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">安全、私密的在线 PDF 文档处理工具。</p>
    </div>
    
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <ToolCard href="/zh/merge-pdf" title="合并 PDF" desc="把多个 PDF 合并成一个文件。" icon="📎" />
      <ToolCard href="/zh/split-pdf" title="拆分 PDF" desc="把 PDF 拆分成单页或提取特定页面。" icon="✂️" />
    </div>
  </main>
  <Footer lang="zh" />
</BaseLayout>