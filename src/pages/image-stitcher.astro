---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout
  title="Image Stitcher — Combine Images Vertically Online"
  description="Free online image stitcher. Combine multiple images vertically into a single long image. Customize background color and spacing. 100% private."
  lang="en"
>
  <Header lang="en" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">Image Stitcher</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Long Image Stitcher</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Combine multiple images vertically into one seamless long image.
      </p>
    </div>

    <!-- 上传区 -->
    <label for="file-input" id="drop-zone" style="height: 180px;" class="relative mx-auto mb-8 flex w-full cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-gray-300 bg-gray-50 transition hover:border-indigo-400 hover:bg-indigo-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-indigo-600 dark:hover:bg-indigo-900/20">
      <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100 dark:bg-indigo-900/50">
        <svg class="h-6 w-6 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      </div>
      <p class="text-base font-medium text-gray-700 dark:text-gray-300">Click or drag images here to stitch</p>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Upload multiple images (in order)</p>
      <input type="file" id="file-input" multiple accept="image/*" style="display: none;" />
    </label>

    <!-- 工作区 (默认隐藏) -->
    <div id="workspace" class="hidden grid gap-6 lg:grid-cols-3">
      
      <!-- 左侧设置面板 -->
      <div class="flex flex-col gap-5 rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <h3 class="font-bold text-gray-900 dark:text-white">Settings</h3>
        
        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Spacing (px)</label>
          <input type="range" id="spacing" min="0" max="50" value="0" class="w-full accent-indigo-600" />
          <span id="spacing-val" class="text-xs text-gray-500">0 px</span>
        </div>

        <div>
          <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Background Color</label>
          <input type="color" id="bg-color" value="#ffffff" class="h-9 w-full cursor-pointer rounded-md border border-gray-300 bg-transparent dark:border-gray-700" />
        </div>

        <hr class="border-gray-200 dark:border-gray-700" />
        
        <button id="stitch-btn" class="w-full rounded-lg bg-indigo-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-indigo-700 active:scale-95 disabled:opacity-50">
          Generate Image
        </button>
        <button id="download-btn" class="hidden w-full rounded-lg bg-green-600 px-4 py-3 font-bold text-white shadow-md transition hover:bg-green-700 active:scale-95">
          Download PNG
        </button>
        
        <div id="status-text" class="text-center text-xs text-gray-500 dark:text-gray-400"></div>
      </div>

      <!-- 右侧预览与列表 -->
      <div class="flex flex-col gap-4 lg:col-span-2">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Image Order</span>
          <button id="clear-btn" class="text-xs text-red-500 hover:underline">Clear All</button>
        </div>
        
        <!-- 图片列表 -->
        <div id="image-list" class="space-y-2 max-h-[250px] overflow-y-auto pr-2"></div>
        
        <!-- 预览画布区 -->
        <div id="preview-area" class="hidden flex-col items-center justify-center rounded-xl border border-gray-200 bg-gray-100 p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
          <div class="relative w-full max-h-[60vh] overflow-y-auto overflow-x-hidden flex justify-center bg-white border border-gray-300 dark:border-gray-700">
            <!-- 用于展示最终拼接结果，限制宽度防止撑爆 -->
            <img id="final-image" class="max-w-full block" />
          </div>
        </div>
      </div>

    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">Related Tools</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/crop-image" title="Crop Image" desc="Crop, rotate, and flip images precisely." icon="✂️" />
        <ToolCard href="/image-to-pdf" title="Image to PDF" desc="Convert JPG and PNG to PDF document." icon="📄" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>Will my images be compressed?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">No. The stitcher uses the original image resolutions and stitches them locally without any server-side compression.</p>
      </details>
    </div>

  </main>

  <Footer lang="en" />

  <script>
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const workspace = document.getElementById('workspace') as HTMLDivElement;
    const imageList = document.getElementById('image-list') as HTMLDivElement;
    const spacingInput = document.getElementById('spacing') as HTMLInputElement;
    const spacingVal = document.getElementById('spacing-val') as HTMLSpanElement;
    const bgColorInput = document.getElementById('bg-color') as HTMLInputElement;
    const stitchBtn = document.getElementById('stitch-btn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
    const statusText = document.getElementById('status-text') as HTMLDivElement;
    const previewArea = document.getElementById('preview-area') as HTMLDivElement;
    const finalImage = document.getElementById('final-image') as HTMLImageElement;

    let files: File[] = [];

    spacingInput.addEventListener('input', () => {
      spacingVal.textContent = spacingInput.value + ' px';
    });

    fileInput.addEventListener('change', () => {
      if (!fileInput.files?.length) return;
      const newFiles = Array.from(fileInput.files).filter(f => f.type.startsWith('image/')).slice(0, 20);
      files = [...files, ...newFiles];
      renderList();
    });

    clearBtn.addEventListener('click', () => {
      files = [];
      renderList();
    });

    function renderList() {
      imageList.innerHTML = '';
      
      if (files.length === 0) {
        workspace.classList.add('hidden');
        workspace.classList.remove('grid');
        return;
      }

      workspace.classList.remove('hidden');
      workspace.classList.add('grid');

      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-2 shadow-sm dark:border-gray-800 dark:bg-gray-900';
        
        row.innerHTML = `
          <div style="width: 40px; height: 40px;" class="shrink-0 overflow-hidden rounded bg-gray-100 dark:bg-gray-800">
            <img style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div class="flex-1 overflow-hidden">
            <p class="truncate text-xs font-medium text-gray-900 dark:text-white">${file.name}</p>
          </div>
          <div class="flex items-center gap-1">
            <button class="move-up p-1 text-gray-400 hover:text-indigo-600 ${index === 0 ? 'opacity-30' : ''}" ${index === 0 ? 'disabled' : ''}>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
            </button>
            <button class="move-down p-1 text-gray-400 hover:text-indigo-600 ${index === files.length - 1 ? 'opacity-30' : ''}" ${index === files.length - 1 ? 'disabled' : ''}>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <button class="remove-btn p-1 text-red-400 hover:text-red-600">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
          </div>
        `;

        const reader = new FileReader();
        reader.onload = (e) => {
          const imgEl = row.querySelector('img');
          if (imgEl) imgEl.src = e.target?.result as string;
        };
        reader.readAsDataURL(file);

        row.querySelector('.move-up')?.addEventListener('click', () => {
          if (index > 0) {
            [files[index - 1], files[index]] = [files[index], files[index - 1]];
            renderList();
          }
        });

        row.querySelector('.move-down')?.addEventListener('click', () => {
          if (index < files.length - 1) {
            [files[index + 1], files[index]] = [files[index], files[index + 1]];
            renderList();
          }
        });

        row.querySelector('.remove-btn')?.addEventListener('click', () => {
          files.splice(index, 1);
          renderList();
        });

        imageList.appendChild(row);
      });
    }

    // 核心拼接逻辑
    stitchBtn.addEventListener('click', async () => {
      if (files.length === 0) return;
      
      stitchBtn.disabled = true;
      statusText.textContent = "Stitching images...";

      try {
        const spacing = parseInt(spacingInput.value);
        const bgColor = bgColorInput.value;

        // 1. 加载所有图片
        const images = await Promise.all(files.map(async (file) => {
          const url = URL.createObjectURL(file);
          const img = new Image();
          await new Promise((res, rej) => { img.onload = res; img.onerror = rej; img.src = url; });
          return img;
        }));

        // 2. 计算最终画布尺寸
        let maxWidth = 0;
        let totalHeight = 0;

        images.forEach((img) => {
          maxWidth = Math.max(maxWidth, img.width);
          totalHeight += img.height;
        });
        
        // 加上间距的总高度
        totalHeight += spacing * (images.length - 1);

        // 3. 创建画布并绘制
        const canvas = document.createElement('canvas');
        canvas.width = maxWidth;
        canvas.height = totalHeight;
        const ctx = canvas.getContext('2d')!;

        // 填充背景色
        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        let currentY = 0;
        images.forEach((img) => {
          // 图片水平居中绘制
          const x = (maxWidth - img.width) / 2;
          ctx.drawImage(img, x, currentY);
          currentY += img.height + spacing;
        });

        // 4. 导出并显示
        const dataUrl = canvas.toDataURL('image/png');
        finalImage.src = dataUrl;
        
        previewArea.classList.remove('hidden');
        previewArea.classList.add('flex');
        downloadBtn.classList.remove('hidden');
        
        statusText.textContent = "Stitching complete!";
      } catch (err) {
        console.error(err);
        statusText.textContent = "Error stitching images.";
      } finally {
        stitchBtn.disabled = false;
      }
    });

    downloadBtn.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = finalImage.src;
      a.download = 'stitched-image.png';
      a.click();
    });
  </script>
</BaseLayout>