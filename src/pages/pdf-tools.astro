---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout title="PDF Tools" description="Free online PDF tools." lang="en">
  <Header lang="en" />
  <main class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">PDF Tools</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">Secure and private online PDF document processing tools.</p>
    </div>
    
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <ToolCard href="/merge-pdf" title="Merge PDF" desc="Combine multiple PDFs into one file." icon="📎" />
      <ToolCard href="/split-pdf" title="Split PDF" desc="Split a PDF into separate pages." icon="✂️" />
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>