---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="404 - Page Not Found" description="Page not found." lang="en">
  <Header lang="en" />
  <main class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <h1 class="text-9xl font-bold text-indigo-600 dark:text-indigo-400">404</h1>
    <p class="mt-4 text-2xl font-semibold text-gray-900 dark:text-white">Page not found</p>
    <p class="mt-2 text-gray-600 dark:text-gray-400">The tool you are looking for doesn't exist or has been moved.</p>
    <a href="/" class="mt-8 rounded-lg bg-indigo-600 px-6 py-2.5 text-white hover:bg-indigo-700">Back to Home</a>
  </main>
  <Footer lang="en" />
</BaseLayout>