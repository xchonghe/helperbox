---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout
  title="Base64 Encoder & Decoder — Encode Text and Files"
  description="Free online Base64 encoder and decoder. Encode text or files to Base64, or decode Base64 back to text. Secure, fast, and entirely browser-based."
  lang="en"
>
  <!-- FAQ 结构化数据 -->
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Base64 encoding?",
        "acceptedAnswer": { "@type": "Answer", "text": "Base64 is a binary-to-text encoding scheme that represents binary data in an ASCII string format by translating it into a radix-64 representation." }
      },
      {
        "@type": "Question",
        "name": "Why does my Base64 string look longer than the original data?",
        "acceptedAnswer": { "@type": "Answer", "text": "Base64 encoding increases the size of the data by approximately 33%, as it uses 4 characters to represent every 3 bytes of data." }
      }
    ]
  }
  </script>

  <Header lang="en" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">Base64 Encoder / Decoder</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">Base64 Encoder / Decoder</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Encode plain text or files into Base64, or decode Base64 strings back to their original format. All processing is local.
      </p>
    </div>

    <!-- 模式切换 Tabs -->
    <div class="mb-6 flex gap-2 border-b border-gray-200 dark:border-gray-800">
      <button id="tab-text" class="border-b-2 border-indigo-600 px-4 py-2 text-sm font-medium text-indigo-600 dark:border-indigo-400 dark:text-indigo-400">Text Mode</button>
      <button id="tab-file" class="border-b-2 border-transparent px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">File to Base64</button>
    </div>

    <!-- 核心操作区 -->
    <div class="grid gap-4 lg:grid-cols-2">
      <!-- 左侧输入 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium" id="input-label">Input Text</span>
          <button id="clear-btn" class="text-xs text-gray-500 hover:text-red-500 transition">Clear</button>
        </div>
        <textarea id="input-area" class="h-[350px] w-full resize-none bg-transparent p-4 font-mono text-sm outline-none placeholder:text-gray-400" placeholder="Type or paste text here..."></textarea>
        
        <!-- 文件上传区 (默认隐藏) -->
        <div id="file-drop-area" class="hidden h-[350px] flex-col items-center justify-center p-4 text-center">
          <svg class="mb-4 h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
          <p class="text-sm text-gray-600 dark:text-gray-400">Drag & drop a file here, or</p>
          <label class="mt-2 cursor-pointer rounded-md bg-indigo-50 px-4 py-2 text-sm font-medium text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-400 dark:hover:bg-indigo-900/50">
            Browse File
            <input type="file" id="file-input" class="hidden" />
          </label>
        </div>
      </div>

      <!-- 右侧输出 -->
      <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between border-b border-gray-200 bg-gray-50 px-4 py-2 dark:border-gray-800 dark:bg-gray-900/50">
          <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Output</span>
          <div class="flex gap-2">
            <button id="encode-btn" class="rounded-md bg-indigo-600 px-3 py-1 text-xs font-medium text-white transition hover:bg-indigo-700">Encode</button>
            <button id="decode-btn" class="rounded-md bg-gray-200 px-3 py-1 text-xs font-medium transition hover:bg-gray-300 dark:bg-gray-800 dark:hover:bg-gray-700">Decode</button>
            <button id="copy-btn" class="rounded-md px-2 py-1 text-xs text-gray-500 transition hover:bg-gray-200 dark:hover:bg-gray-800">Copy</button>
            <button id="download-btn" class="hidden rounded-md px-2 py-1 text-xs text-gray-500 transition hover:bg-gray-200 dark:hover:bg-gray-800">Download</button>
          </div>
        </div>
        <textarea id="output-area" readonly class="h-[350px] w-full resize-none bg-gray-50/50 p-4 font-mono text-sm outline-none dark:bg-gray-900/50" placeholder="Result will appear here..."></textarea>
      </div>
    </div>

    <div id="error-msg" class="mt-4 hidden rounded-lg bg-red-50 p-4 text-sm text-red-600 dark:bg-red-900/20 dark:text-red-400"></div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">Related Tools</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/json-formatter" title="JSON Formatter" desc="Format and validate JSON instantly." icon="{ }" />
        <ToolCard href="/uuid-generator" title="UUID Generator" desc="Generate random UUID v4 values." icon="🆔" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
      
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>What is Base64 encoding?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          Base64 is a binary-to-text encoding scheme that represents binary data in an ASCII string format. It's commonly used to embed images or files directly into HTML or CSS.
        </p>
      </details>

      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>Why does the encoded text look longer?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
          Base64 increases the size of the data by approximately 33%, because it uses 4 characters to represent every 3 bytes of binary data.
        </p>
      </details>
    </div>

  </main>

  <Footer lang="en" />

  <script>
    const tabText = document.getElementById('tab-text') as HTMLButtonElement;
    const tabFile = document.getElementById('tab-file') as HTMLButtonElement;
    const inputArea = document.getElementById('input-area') as HTMLTextAreaElement;
    const fileDropArea = document.getElementById('file-drop-area') as HTMLDivElement;
    const inputLabel = document.getElementById('input-label') as HTMLSpanElement;
    const outputArea = document.getElementById('output-area') as HTMLTextAreaElement;
    const errorMsg = document.getElementById('error-msg') as HTMLDivElement;
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const encodeBtn = document.getElementById('encode-btn') as HTMLButtonElement;
    const decodeBtn = document.getElementById('decode-btn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
    
    let currentMode: 'text' | 'file' = 'text';

    // 切换 Tab
    tabText.addEventListener('click', () => {
      currentMode = 'text';
      tabText.className = 'border-b-2 border-indigo-600 px-4 py-2 text-sm font-medium text-indigo-600 dark:border-indigo-400 dark:text-indigo-400';
      tabFile.className = 'border-b-2 border-transparent px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200';
      inputLabel.textContent = 'Input Text';
      inputArea.classList.remove('hidden');
      fileDropArea.classList.add('hidden');
      fileDropArea.classList.remove('flex');
      decodeBtn.classList.remove('hidden');
      downloadBtn.classList.add('hidden');
    });

    tabFile.addEventListener('click', () => {
      currentMode = 'file';
      tabFile.className = 'border-b-2 border-indigo-600 px-4 py-2 text-sm font-medium text-indigo-600 dark:border-indigo-400 dark:text-indigo-400';
      tabText.className = 'border-b-2 border-transparent px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200';
      inputLabel.textContent = 'Upload File';
      inputArea.classList.add('hidden');
      fileDropArea.classList.remove('hidden');
      fileDropArea.classList.add('flex');
      decodeBtn.classList.add('hidden'); // 文件模式不支持解码
      downloadBtn.classList.remove('hidden');
    });

    // 文本处理逻辑（注意处理中文乱码）
    function processText(action: 'encode' | 'decode') {
      const raw = inputArea.value.trim();
      if (!raw) return;
      try {
        if (action === 'encode') {
          // 使用 encodeURIComponent 处理中文
          outputArea.value = btoa(unescape(encodeURIComponent(raw)));
        } else {
          outputArea.value = decodeURIComponent(escape(atob(raw)));
        }
        errorMsg.classList.add('hidden');
      } catch (e: any) {
        outputArea.value = '';
        errorMsg.textContent = `Error: Invalid input for ${action}.`;
        errorMsg.classList.remove('hidden');
      }
    }

    encodeBtn.addEventListener('click', () => { if(currentMode === 'text') processText('encode'); });
    decodeBtn.addEventListener('click', () => { if(currentMode === 'text') processText('decode'); });
    
    document.getElementById('clear-btn')?.addEventListener('click', () => {
      inputArea.value = '';
      outputArea.value = '';
      errorMsg.classList.add('hidden');
    });

    // 复制逻辑
    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      if(!outputArea.value) return;
      await navigator.clipboard.writeText(outputArea.value);
      const btn = document.getElementById('copy-btn') as HTMLButtonElement;
      btn.textContent = 'Copied!';
      setTimeout(() => btn.textContent = 'Copy', 2000);
    });

    // 文件读取逻辑
    fileInput.addEventListener('change', (e: Event) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        outputArea.value = reader.result as string; // 结果是 data:image/png;base64,... 格式
        errorMsg.classList.add('hidden');
      };
      reader.onerror = () => {
        errorMsg.textContent = 'Error reading file.';
        errorMsg.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });

    // 下载 Base64 为 txt
    downloadBtn.addEventListener('click', () => {
      if (!outputArea.value) return;
      const blob = new Blob([outputArea.value], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'base64-output.txt';
      a.click();
      URL.revokeObjectURL(url);
    });
  </script>
</BaseLayout>