---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout
  title="Color Converter — HEX, RGB, HSL & Palette Generator"
  description="Free online color converter. Convert HEX to RGB, HSL instantly. Generate complementary colors, lighter and darker shades. Copy color codes with one click."
  lang="en"
>
  <Header lang="en" />

  <main class="mx-auto max-w-5xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">Color Converter</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Color Converter & Palette</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Pick a color to instantly get HEX, RGB, HSL formats, and generate beautiful color palettes.
      </p>
    </div>

    <!-- 主调色区 -->
    <div class="grid gap-6 md:grid-cols-2">
      <!-- 拾色器 -->
      <div class="flex flex-col items-center justify-center rounded-2xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        <div class="relative h-40 w-40 overflow-hidden rounded-full border-4 border-gray-100 shadow-inner dark:border-gray-800 cursor-pointer" id="color-preview">
          <input type="color" id="color-picker" value="#6366f1" class="absolute -inset-4 h-[calc(100%+2rem)] w-[calc(100%+2rem)] cursor-pointer opacity-0" />
        </div>
        <p class="mt-6 text-sm text-gray-500 dark:text-gray-400">Click to pick a color</p>
      </div>

      <!-- 颜色数值 -->
      <div class="flex flex-col justify-center gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
        
        <!-- HEX -->
        <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <span class="text-sm font-bold text-gray-500 w-12">HEX</span>
          <span id="val-hex" class="font-mono text-sm font-medium text-gray-900 dark:text-white flex-1">#6366F1</span>
          <button class="copy-btn text-xs text-indigo-600 hover:underline" data-target="val-hex">Copy</button>
        </div>

        <!-- RGB -->
        <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <span class="text-sm font-bold text-gray-500 w-12">RGB</span>
          <span id="val-rgb" class="font-mono text-sm font-medium text-gray-900 dark:text-white flex-1">rgb(99, 102, 241)</span>
          <button class="copy-btn text-xs text-indigo-600 hover:underline" data-target="val-rgb">Copy</button>
        </div>

        <!-- HSL -->
        <div class="flex items-center justify-between rounded-lg bg-gray-50 p-3 dark:bg-gray-800">
          <span class="text-sm font-bold text-gray-500 w-12">HSL</span>
          <span id="val-hsl" class="font-mono text-sm font-medium text-gray-900 dark:text-white flex-1">hsl(239, 84%, 67%)</span>
          <button class="copy-btn text-xs text-indigo-600 hover:underline" data-target="val-hsl">Copy</button>
        </div>
      </div>
    </div>

    <!-- 自动生成的调色板 -->
    <div class="mt-10">
      <h2 class="mb-4 text-xl font-bold text-gray-900 dark:text-white">Color Palette</h2>
      
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
        <!-- 互补色 -->
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-800">
          <div id="color-complement" class="h-24 w-full transition-colors duration-300"></div>
          <div class="bg-white p-2 text-center dark:bg-gray-900">
            <div class="text-xs font-medium text-gray-900 dark:text-white">Complement</div>
            <button class="copy-btn mt-1 text-xs text-indigo-600" data-target="val-complement">#000000</button>
            <span id="val-complement" class="hidden">#000000</span>
          </div>
        </div>

        <!-- 变浅 20% -->
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-800">
          <div id="color-light-1" class="h-24 w-full transition-colors duration-300"></div>
          <div class="bg-white p-2 text-center dark:bg-gray-900">
            <div class="text-xs font-medium text-gray-900 dark:text-white">Lighter</div>
            <button class="copy-btn mt-1 text-xs text-indigo-600" data-target="val-light-1">#000000</button>
            <span id="val-light-1" class="hidden">#000000</span>
          </div>
        </div>

        <!-- 变浅 40% -->
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-800">
          <div id="color-light-2" class="h-24 w-full transition-colors duration-300"></div>
          <div class="bg-white p-2 text-center dark:bg-gray-900">
            <div class="text-xs font-medium text-gray-900 dark:text-white">Lightest</div>
            <button class="copy-btn mt-1 text-xs text-indigo-600" data-target="val-light-2">#000000</button>
            <span id="val-light-2" class="hidden">#000000</span>
          </div>
        </div>

        <!-- 变深 20% -->
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-800">
          <div id="color-dark-1" class="h-24 w-full transition-colors duration-300"></div>
          <div class="bg-white p-2 text-center dark:bg-gray-900">
            <div class="text-xs font-medium text-gray-900 dark:text-white">Darker</div>
            <button class="copy-btn mt-1 text-xs text-indigo-600" data-target="val-dark-1">#000000</button>
            <span id="val-dark-1" class="hidden">#000000</span>
          </div>
        </div>

        <!-- 变深 40% -->
        <div class="flex flex-col overflow-hidden rounded-xl border border-gray-200 shadow-sm dark:border-gray-800">
          <div id="color-dark-2" class="h-24 w-full transition-colors duration-300"></div>
          <div class="bg-white p-2 text-center dark:bg-gray-900">
            <div class="text-xs font-medium text-gray-900 dark:text-white">Darkest</div>
            <button class="copy-btn mt-1 text-xs text-indigo-600" data-target="val-dark-2">#000000</button>
            <span id="val-dark-2" class="hidden">#000000</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">Related Tools</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/image-watermark" title="Image Watermark" desc="Add custom text watermarks to photos." icon="💧" />
        <ToolCard href="/base64" title="Base64 Converter" desc="Convert text to and from Base64." icon="🔐" />
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>What is HSL?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">HSL stands for Hue, Saturation, and Lightness. It is an alternative color model to RGB, often easier for humans to understand and manipulate.</p>
      </details>
    </div>

  </main>

  <Footer lang="en" />

  <script>
    const picker = document.getElementById('color-picker') as HTMLInputElement;
    const preview = document.getElementById('color-preview') as HTMLDivElement;
    
    // 颜色值展示元素
    const valHex = document.getElementById('val-hex') as HTMLSpanElement;
    const valRgb = document.getElementById('val-rgb') as HTMLSpanElement;
    const valHsl = document.getElementById('val-hsl') as HTMLSpanElement;

    // 调色板元素
    const compBox = document.getElementById('color-complement') as HTMLDivElement;
    const light1Box = document.getElementById('color-light-1') as HTMLDivElement;
    const light2Box = document.getElementById('color-light-2') as HTMLDivElement;
    const dark1Box = document.getElementById('color-dark-1') as HTMLDivElement;
    const dark2Box = document.getElementById('color-dark-2') as HTMLDivElement;

    // HEX 转 RGB
    function hexToRgb(hex: string) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return { r, g, b };
    }

    // RGB 转 HSL
    function rgbToHsl(r: number, g: number, b: number) {
      r /= 255; g /= 255; b /= 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0;
      const l = (max + min) / 2;

      if (max !== min) {
        const d = max - min;
        s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
        switch (max) {
          case r: h = (g - b) / d + (g < b ? 6 : 0); break;
          case g: h = (b - r) / d + 2; break;
          case b: h = (r - g) / d + 4; break;
        }
        h /= 6;
      }
      return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
    }

    // HSL 转 HEX
    function hslToHex(h: number, s: number, l: number) {
      l /= 100;
      const a = s * Math.min(l, 1 - l) / 100;
      const f = (n: number) => {
        const k = (n + h / 30) % 12;
        const color = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
        return Math.round(255 * color).toString(16).padStart(2, '0');
      };
      return `#${f(0)}${f(8)}${f(4)}`.toUpperCase();
    }

    function updateColors() {
      const hex = picker.value.toUpperCase();
      const { r, g, b } = hexToRgb(hex);
      const { h, s, l } = rgbToHsl(r, g, b);

      // 1. 更新主面板
      preview.style.backgroundColor = hex;
      valHex.textContent = hex;
      valRgb.textContent = `rgb(${r}, ${g}, ${b})`;
      valHsl.textContent = `hsl(${h}, ${s}%, ${l}%)`;

      // 2. 计算调色板
      // 互补色 (色相+180)
      const compH = (h + 180) % 360;
      const compHex = hslToHex(compH, s, l);

      // 变浅 (增加明度)
      const light1Hex = hslToHex(h, s, Math.min(l + 15, 100));
      const light2Hex = hslToHex(h, s, Math.min(l + 30, 100));

      // 变深 (降低明度)
      const dark1Hex = hslToHex(h, s, Math.max(l - 15, 0));
      const dark2Hex = hslToHex(h, s, Math.max(l - 30, 0));

      // 渲染调色板
      renderPalette('complement', compHex, compBox, 'val-complement');
      renderPalette('light1', light1Hex, light1Box, 'val-light-1');
      renderPalette('light2', light2Hex, light2Box, 'val-light-2');
      renderPalette('dark1', dark1Hex, dark1Box, 'val-dark-1');
      renderPalette('dark2', dark2Hex, dark2Box, 'val-dark-2');
    }

    function renderPalette(id: string, hex: string, box: HTMLDivElement, textId: string) {
      box.style.backgroundColor = hex;
      const textEl = document.getElementById(textId) as HTMLSpanElement;
      textEl.textContent = hex;
      // 更新复制按钮的文字
      const btn = document.querySelector(`.copy-btn[data-target="${textId}"]`) as HTMLButtonElement;
      if(btn) btn.textContent = hex;
    }

    picker.addEventListener('input', updateColors);

    // 复制功能
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const targetId = (e.target as HTMLElement).dataset.target;
        if (!targetId) return;
        const textToCopy = document.getElementById(targetId)?.textContent || '';
        
        await navigator.clipboard.writeText(textToCopy);
        const el = e.target as HTMLElement;
        const originalText = el.textContent;
        el.textContent = 'Copied!';
        el.classList.add('text-green-600');
        
        setTimeout(() => {
          el.textContent = originalText;
          el.classList.remove('text-green-600');
        }, 1500);
      });
    });

    // 初始化
    updateColors();
  </script>
</BaseLayout>