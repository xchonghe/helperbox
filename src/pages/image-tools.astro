---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout title="Image Tools" description="Free online image tools." lang="en">
  <Header lang="en" />
  <main class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Image Tools</h1>
      <p class="mt-4 text-gray-600 dark:text-gray-400">A collection of privacy-first image processing tools.</p>
    </div>
    
    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
      <ToolCard href="/crop-image" title="Crop Image" desc="Crop, rotate, and flip images precisely." icon="✂️" />
      <ToolCard href="/compress-image" title="Compress Image" desc="Shrink image file size without losing quality." icon="🗜️" />
      <ToolCard href="/convert-image" title="Convert Image" desc="Convert between JPG, PNG, and WebP." icon="🔄" />
      <ToolCard href="/resize-image" title="Resize Image" desc="Change image dimensions in your browser." icon="📐" />
      <ToolCard href="/watermark" title="Image Watermark" desc="Add custom text watermarks to photos." icon="💧" />
      <ToolCard href="/remove-watermark" title="AI Watermark Remover" desc="Remove watermarks from images with our smart algorithm." icon="✨" />
      <ToolCard href="/image-to-pdf" title="Image to PDF" desc="Convert JPG and PNG to PDF document." icon="📄" />
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>