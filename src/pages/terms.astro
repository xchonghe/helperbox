---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Terms of Service" description="Terms of Service for our online tools." lang="en">
  <Header lang="en" />
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="mb-6 text-3xl font-bold">Terms of Service</h1>
    <div class="space-y-4 text-gray-600 dark:text-gray-400">
      <p>By using this website, you agree to these terms.</p>
      
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mt-6">1. Use of Tools</h2>
      <p>Our tools are provided "as is" and "as available". You are free to use them for personal or commercial purposes. We do not claim ownership over the files you process using our tools.</p>
      
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mt-6">2. Disclaimer of Liability</h2>
      <p>While we strive for 100% accuracy, we are not responsible for any data loss or damage caused by the use of our tools. Always keep a backup of your original files.</p>
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>