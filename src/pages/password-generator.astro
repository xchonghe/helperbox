---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
---
<BaseLayout
  title="Password Generator — Secure Random Password Generator"
  description="Generate strong, random passwords instantly in your browser. Customize length, characters, and exclude ambiguous ones. 100% secure and private."
  lang="en"
>
  <Header lang="en" />

  <main class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    
    <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400">
      <a href="/" class="hover:text-indigo-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">Password Generator</span>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Password Generator</h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Create strong and secure passwords to keep your accounts safe. All generation happens locally.
      </p>
    </div>

    <!-- 主输出区 -->
    <div class="mb-8 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
      <div class="relative flex items-center justify-between border-b border-gray-200 bg-gray-50 p-4 dark:border-gray-800 dark:bg-gray-900/50">
        <div id="password-output" class="break-all font-mono text-xl font-bold text-gray-900 md:text-2xl dark:text-white selection:bg-indigo-100 selection:text-indigo-900 dark:selection:bg-indigo-900 dark:selection:text-indigo-100">
          Click Generate...
        </div>
        <div class="ml-4 flex items-center gap-2">
          <button id="refresh-btn" class="rounded-md p-2 text-gray-500 transition hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-800 dark:hover:text-white" title="Regenerate">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          </button>
          <button id="copy-btn" class="rounded-md bg-indigo-600 p-2 text-white transition hover:bg-indigo-700 active:scale-95" title="Copy">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          </button>
        </div>
      </div>
      
      <!-- 强度指示器 -->
      <div class="flex items-center gap-3 p-4">
        <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Strength:</span>
        <div class="flex h-2 flex-1 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-800">
          <div id="strength-bar" class="w-0 bg-red-500 transition-all duration-300"></div>
        </div>
        <span id="strength-text" class="text-xs font-bold uppercase text-red-500 w-16 text-right">None</span>
      </div>
    </div>

    <!-- 设置面板 -->
    <div class="grid gap-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900 md:grid-cols-2">
      
      <!-- 左侧：长度 -->
      <div>
        <div class="mb-2 flex items-center justify-between">
          <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Password Length</label>
          <span id="length-val" class="font-mono text-sm font-bold text-indigo-600 dark:text-indigo-400">16</span>
        </div>
        <input type="range" id="length-slider" min="8" max="64" value="16" class="w-full accent-indigo-600" />
        
        <div class="mt-6 flex gap-2">
          <button id="gen-btn" class="flex-1 rounded-xl bg-indigo-600 px-4 py-3 text-sm font-medium text-white transition hover:bg-indigo-700 active:scale-95">
            Generate Password
          </button>
          <button id="gen-multi-btn" class="rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">
            Generate 10
          </button>
        </div>
      </div>

      <!-- 右侧：选项 -->
      <div class="space-y-3">
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="opt-upper" checked class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
          <span class="text-sm text-gray-700 dark:text-gray-300">Uppercase (A-Z)</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="opt-lower" checked class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
          <span class="text-sm text-gray-700 dark:text-gray-300">Lowercase (a-z)</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="opt-numbers" checked class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
          <span class="text-sm text-gray-700 dark:text-gray-300">Numbers (0-9)</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" id="opt-symbols" checked class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
          <span class="text-sm text-gray-700 dark:text-gray-300">Symbols (!@#$...)</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer pt-2 border-t border-gray-100 dark:border-gray-800">
          <input type="checkbox" id="opt-ambiguous" class="h-4 w-4 rounded border-gray-300 accent-indigo-600" />
          <span class="text-sm text-gray-700 dark:text-gray-300">Exclude Ambiguous</span>
        </label>
      </div>
    </div>

    <!-- 批量结果展示区 (默认隐藏) -->
    <div id="multi-output" class="mt-8 hidden">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white">Generated Passwords</h3>
        <button id="copy-all-btn" class="text-sm text-indigo-600 hover:underline">Copy All</button>
      </div>
      <div id="multi-list" class="space-y-2"></div>
    </div>
    <!-- 相关工具 -->
    <div class="mt-16">
      <h2 class="mb-5 text-xl font-bold text-gray-900 dark:text-gray-100">Related Tools</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ToolCard href="/uuid-generator" title="UUID Generator" desc="Generate random UUID v4 values." icon="🆔" />
        <ToolCard href="/base64" title="Base64 Converter" desc="Convert text to and from Base64." icon="🔐" />
      </div>
    </div>
    <!-- FAQ -->
    <div class="mt-16 space-y-4">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Frequently Asked Questions</h2>
      <details class="group rounded-xl border border-gray-200 bg-white p-4 open:bg-gray-50 dark:border-gray-800 dark:bg-gray-900 dark:open:bg-gray-900/50">
        <summary class="cursor-pointer list-none flex justify-between items-center font-medium text-gray-900 dark:text-gray-100">
          <span>Is this password generator safe?</span>
          <span class="text-gray-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Yes. It uses the Web Crypto API (crypto.getRandomValues) to generate cryptographically secure random passwords entirely in your browser. No passwords are sent over the internet.</p>
      </details>
    </div>

  </main>

  <Footer lang="en" />

  <script>
    const lengthSlider = document.getElementById('length-slider') as HTMLInputElement;
    const lengthVal = document.getElementById('length-val') as HTMLSpanElement;
    const output = document.getElementById('password-output') as HTMLDivElement;
    const strengthBar = document.getElementById('strength-bar') as HTMLDivElement;
    const strengthText = document.getElementById('strength-text') as HTMLSpanElement;
    
    // 选项输入
    const optUpper = document.getElementById('opt-upper') as HTMLInputElement;
    const optLower = document.getElementById('opt-lower') as HTMLInputElement;
    const optNumbers = document.getElementById('opt-numbers') as HTMLInputElement;
    const optSymbols = document.getElementById('opt-symbols') as HTMLInputElement;
    const optAmbiguous = document.getElementById('opt-ambiguous') as HTMLInputElement;

    // 批量生成区
    const multiOutput = document.getElementById('multi-output') as HTMLDivElement;
    const multiList = document.getElementById('multi-list') as HTMLDivElement;

    // 字符集
    const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const LOWER = 'abcdefghijklmnopqrstuvwxyz';
    const NUMBERS = '0123456789';
    const SYMBOLS = '!@#$%^&*()_+~`|}{[]:;?><,./-=';
    const AMBIGUOUS = 'il1Lo0O';

    lengthSlider.addEventListener('input', () => {
      lengthVal.textContent = lengthSlider.value;
    });

    function getCharset() {
      let charset = '';
      if (optUpper.checked) charset += UPPER;
      if (optLower.checked) charset += LOWER;
      if (optNumbers.checked) charset += NUMBERS;
      if (optSymbols.checked) charset += SYMBOLS;
      
      if (optAmbiguous.checked) {
        // 过滤掉容易混淆的字符
        charset = charset.split('').filter(c => !AMBIGUOUS.includes(c)).join('');
      }
      
      // 防呆：如果全不选，默认给个小写
      if (!charset) charset = LOWER;
      return charset;
    }

    function generatePassword(length: number, charset: string) {
      let password = '';
      const randomValues = new Uint32Array(length);
      crypto.getRandomValues(randomValues); // 核心：密码学安全的随机数
      
      for (let i = 0; i < length; i++) {
        password += charset[randomValues[i] % charset.length];
      }
      return password;
    }

    function updateStrength(password: string) {
      // 用信息熵来粗略计算强度 (Entropy = Length * log2(CharsetSize))
      if (!password || password === 'Click Generate...') return;
      
      const charsetSize = getCharset().length;
      const entropy = password.length * Math.log2(charsetSize);
      
      let percent = 0;
      let colorClass = 'bg-red-500';
      let textClass = 'text-red-500';
      let label = 'Weak';

      if (entropy > 60) { percent = 40; }
      if (entropy > 80) { percent = 60; colorClass = 'bg-yellow-500'; textClass = 'text-yellow-500'; label = 'Medium'; }
      if (entropy > 100) { percent = 80; colorClass = 'bg-blue-500'; textClass = 'text-blue-500'; label = 'Strong'; }
      if (entropy > 128) { percent = 100; colorClass = 'bg-green-500'; textClass = 'text-green-500'; label = 'Very Strong'; }

      strengthBar.style.width = percent + '%';
      strengthBar.className = `h-full transition-all duration-300 ${colorClass}`;
      strengthText.textContent = label;
      strengthText.className = `text-xs font-bold uppercase w-20 text-right ${textClass}`;
    }

    function generateSingle() {
      const length = parseInt(lengthSlider.value);
      const charset = getCharset();
      const pwd = generatePassword(length, charset);
      
      output.textContent = pwd;
      updateStrength(pwd);
      multiOutput.classList.add('hidden'); // 隐藏批量区
    }

    function generateMulti() {
      const length = parseInt(lengthSlider.value);
      const charset = getCharset();
      multiOutput.classList.remove('hidden');
      multiList.innerHTML = '';
      
      for (let i = 0; i < 10; i++) {
        const pwd = generatePassword(length, charset);
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between rounded-lg border border-gray-200 bg-gray-50 p-3 dark:border-gray-800 dark:bg-gray-900/50';
        row.innerHTML = `
          <span class="font-mono text-sm break-all dark:text-gray-200">${pwd}</span>
          <button class="ml-3 text-xs text-indigo-600 hover:underline copy-single" data-pwd="${pwd}">Copy</button>
        `;
        multiList.appendChild(row);
      }

      // 绑定单独复制
      multiList.querySelectorAll('.copy-single').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const pwd = (e.target as HTMLElement).dataset.pwd;
          if (pwd) navigator.clipboard.writeText(pwd);
          (e.target as HTMLElement).textContent = 'Copied!';
          setTimeout(() => (e.target as HTMLElement).textContent = 'Copy', 1500);
        });
      });
      
      // 同时把第一个显示在主面板
      output.textContent = multiList.querySelector('span')?.textContent || '';
      updateStrength(output.textContent);
    }

    // 绑定按钮
    document.getElementById('gen-btn')?.addEventListener('click', generateSingle);
    document.getElementById('refresh-btn')?.addEventListener('click', generateSingle);
    document.getElementById('gen-multi-btn')?.addEventListener('click', generateMulti);

    // 复制主密码
    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      if(output.textContent === 'Click Generate...') return;
      await navigator.clipboard.writeText(output.textContent || '');
      const btn = document.getElementById('copy-btn') as HTMLButtonElement;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = `<span class="text-xs font-bold px-1">OK</span>`;
      setTimeout(() => btn.innerHTML = originalHTML, 1500);
    });

    // 复制全部
    document.getElementById('copy-all-btn')?.addEventListener('click', () => {
      const allPwds = Array.from(multiList.querySelectorAll('span')).map(span => span.textContent).join('\n');
      navigator.clipboard.writeText(allPwds);
      const btn = document.getElementById('copy-all-btn') as HTMLButtonElement;
      btn.textContent = 'Copied All!';
      setTimeout(() => btn.textContent = 'Copy All', 1500);
    });

    // 初始化生成一个
    generateSingle();
  </script>
</BaseLayout>