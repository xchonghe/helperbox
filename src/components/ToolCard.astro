---
interface Props {
  href: string;
  title: string;
  desc: string;
  icon: string;
}
const { href, title, desc, icon } = Astro.props;
---
<a
  href={href}
  data-tool={`${title} ${desc}`}
  class="group flex flex-col gap-1.5 rounded-xl border border-gray-200 bg-white p-3 transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md sm:gap-2 sm:p-5 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-indigo-700"
>
  <span class="text-xl sm:text-2xl">{icon}</span>
  <h3 class="text-sm font-semibold group-hover:text-indigo-600 sm:text-base">{title}</h3>
  <p class="line-clamp-2 text-xs text-gray-600 dark:text-gray-400 sm:text-sm">{desc}</p>
</a>